<UserControl x:Class="ZiraatProje.UI.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZiraatProje.UI.Views"
             xmlns:helpers="clr-namespace:ZiraatProje.UI.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <helpers:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
        <helpers:BindingProxy x:Key="DataContextProxy" Data="{Binding}"/>

        <!-- Radio / Tab Button Style for Quarters -->
        <Style x:Key="QuarterButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ZiraatRed}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ZiraatRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ZiraatRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Main Page Root ScrollViewer: Ensures smooth mouse wheel scrolling over the entire Projects view -->
        <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True" Padding="20">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- View Header & Top Action Bar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Proje Yönetimi &amp; Çeyreklik Talep Planlaması" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Burgundy}"/>
                            <TextBlock Text="Çeyrek bazında projeleri listeleyin, tıklayarak ay ve kişi bazlı detaylı adam/gün dağılımını inceleyin" FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Top Right Action Controls: Search Box & New Request Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Compact Search Box -->
                            <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" CornerRadius="6" Width="220" Height="36" Padding="8,0" Margin="0,0,12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748b"/>

                                    <TextBox Grid.Column="1" 
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             BorderThickness="0" Background="Transparent" 
                                             VerticalAlignment="Center" FontSize="11.5" Foreground="#1e293b"
                                             ToolTip="Pergel No veya Proje Adı yazarak filtreleyin"/>

                                    <Button Grid.Column="2" Content="✕" 
                                            Command="{Binding ClearSearchCommand}" 
                                            Visibility="{Binding SearchText, Converter={StaticResource BoolToVisConverter}}" 
                                            Background="Transparent" BorderThickness="0" 
                                            Foreground="#94a3b8" FontWeight="Bold" FontSize="11" 
                                            Padding="4,0" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Main Top Button: New Request Dialog Trigger (Visible only for Admin & Analysts) -->
                            <Button Content="➕ Yeni Talep Oluştur" 
                                    Command="{Binding OpenCreateFormCommand}" 
                                    Visibility="{Binding CreateProjectButtonVisibility}" 
                                    Height="36" Padding="16,0" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 🤖 AI AKILLI GELİŞTİRİCİ & EFOR ÖNERİ ASİSTANI -->
                    <Border Background="#f8fafc" BorderBrush="#7c3aed" BorderThickness="1.5" CornerRadius="10" Padding="12,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🤖" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI Akıllı Geliştirici Atama &amp; Efor Öneri Asistanı" FontWeight="Bold" FontSize="12.5" Foreground="#1e293b" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleAiProjectCardCommand}" Padding="8,3" FontSize="11">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="✨ En Boşta Geliştiricileri Öner"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiProjectCardExpanded}" Value="True">
                                                    <Setter Property="Content" Value="▲ Gizle"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <StackPanel Visibility="{Binding IsAiProjectCardExpanded, Converter={StaticResource BoolToVisConverter}}">
                                <!-- Ekip Seçici (kompakt) -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,10" VerticalAlignment="Center">
                                    <Border Background="#ede9fe" CornerRadius="6,0,0,6" Padding="10,0" Height="30">
                                        <TextBlock Text="🏷️ Ekip" FontSize="11" FontWeight="Bold" Foreground="#5b21b6" VerticalAlignment="Center"/>
                                    </Border>
                                    <ComboBox ItemsSource="{Binding AiTeamFilterList}"
                                              SelectedItem="{Binding SelectedAiTeamFilter}"
                                              Width="130" Height="30"
                                              FontSize="11.5" Padding="8,4"
                                              BorderBrush="#c4b5fd" Background="White"/>
                                </StackPanel>

                                <!-- Recommendations List -->
                                <ItemsControl ItemsSource="{Binding AiProjectAllocations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding CandidateUser.FullName}" FontWeight="Bold" FontSize="11.5" Foreground="#0f172a" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding CandidateUser.Title}" FontSize="10.5" Foreground="#64748b" Margin="0,0,6,0"/>
                                                            <Border Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding TeamBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/>
                                                            </Border>
                                                            <Border Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="10" Padding="6,1">
                                                                <TextBlock Text="{Binding WorkloadBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#1d4ed8"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RecommendationReason}" FontSize="10" Foreground="#475569"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quarter Selection Bar -->
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Controls (Year & Team Filter) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                            <!-- Year Filter -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Yıl:" FontWeight="Bold" Foreground="#4a5568" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="75" Height="30"/>
                            </StackPanel>

                            <!-- Team Filter -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ekip:" FontWeight="Bold" Foreground="#1e40af" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding TeamFilterList}" SelectedItem="{Binding SelectedTeamFilter}" Width="115" Height="30"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quarter Tabs (Q1, Q2, Q3, Q4 Unclipped) -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding QuarterTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="QuarterGroup" 
                                                 Style="{StaticResource QuarterButtonStyle}"
                                                 Command="{Binding DataContext.SelectQuarterCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectsView}}}"
                                                 CommandParameter="{Binding Quarter}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EqualityToBoolConverter}" Mode="OneWay">
                                                <Binding Path="Quarter"/>
                                                <Binding Path="DataContext.SelectedQuarter" RelativeSource="{RelativeSource AncestorType={x:Type local:ProjectsView}}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding SubTitle, StringFormat=' ({0})'}" FontSize="11" Opacity="0.85"/>
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding ProjectsList.Count, StringFormat='Toplam: {0} Kayıt'}" FontWeight="Bold" Foreground="#475569" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FULL-WIDTH DataGrid Table with Expandable & Collapsible RowDetails -->
                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15">
                    <DataGrid ItemsSource="{Binding ProjectsList}" SelectedItem="{Binding SelectedProjectDisplay}" 
                              AutoGenerateColumns="False" HeadersVisibility="Column" ScrollViewer.CanContentScroll="False" 
                              helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True" CanUserSortColumns="True"
                              RowDetailsVisibilityMode="VisibleWhenSelected"
                              PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.Columns>
                            <!-- Pergel No -->
                            <DataGridTextColumn Header="Pergel No" Binding="{Binding Project.PergelNo}" Width="95" FontWeight="Bold"/>

                            <!-- Talep Özeti / Adı -->
                            <DataGridTextColumn Header="Talep Özeti / Proje Adı" Binding="{Binding Project.ProjectName}" Width="1.6*" FontWeight="Bold"/>

                            <!-- Proje Türü -->
                            <DataGridTemplateColumn Header="Proje Türü" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="8" Padding="6,2" Background="#f1f5f9" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Project.ProjectType}" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                                            </Border>
                                            <TextBlock Text="{Binding Project.ExternalCompanyName, StringFormat=' ({0})'}" FontSize="10.5" Foreground="#c05621" FontWeight="Bold" Visibility="{Binding Project.ExternalCompanyName, Converter={StaticResource BoolToVisConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Durum -->
                            <DataGridTemplateColumn Header="Durum" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#eff6ff"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Planlandı">
                                                            <Setter Property="Background" Value="#fef3c7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Devam Ediyor">
                                                            <Setter Property="Background" Value="#eff6ff"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Tamamlandı">
                                                            <Setter Property="Background" Value="#dcfce7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="İptal">
                                                            <Setter Property="Background" Value="#fee2e2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Project.ProjectStatus}" FontSize="10.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1e40af"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Planlandı">
                                                                <Setter Property="Foreground" Value="#92400e"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Devam Ediyor">
                                                                <Setter Property="Foreground" Value="#1e40af"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Tamamlandı">
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="İptal">
                                                                <Setter Property="Foreground" Value="#991b1b"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- GMY -->
                            <DataGridTextColumn Header="GMY" Binding="{Binding Project.Gmy}" Width="1.2*"/>

                            <!-- İş Birimi -->
                            <DataGridTextColumn Header="İş Birimi" Binding="{Binding Project.BusinessUnit}" Width="1.3*"/>

                            <!-- Analistler -->
                            <DataGridTemplateColumn Header="Analistler" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Project.AssignedAnalystNames}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e40af"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Yazılımcılar -->
                            <DataGridTemplateColumn Header="Yazılımcılar" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Project.AssignedDeveloperNames}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#065f46"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Çeyreğin 3 Ayı için Aylık Toplamlar (BindingProxy ile Dinamik Ay Başlıkları) -->
                            <DataGridTextColumn Header="{Binding Data.Month1Header, Source={StaticResource DataContextProxy}}" 
                                                Binding="{Binding Month1ManDaysTotal, StringFormat=\{0:N0\}}" Width="85"/>

                            <DataGridTextColumn Header="{Binding Data.Month2Header, Source={StaticResource DataContextProxy}}" 
                                                Binding="{Binding Month2ManDaysTotal, StringFormat=\{0:N0\}}" Width="85"/>

                            <DataGridTextColumn Header="{Binding Data.Month3Header, Source={StaticResource DataContextProxy}}" 
                                                Binding="{Binding Month3ManDaysTotal, StringFormat=\{0:N0\}}" Width="85"/>

                            <!-- Toplam Adam/Gün -->
                            <DataGridTextColumn Header="Adam/Gün" Binding="{Binding TotalInternalManDays, StringFormat=\{0:N0\}}" Width="90" FontWeight="Bold"/>

                            <!-- Dış Maliyet (Sadece Sayı Gösterimi) -->
                            <DataGridTemplateColumn Header="Dış Maliyet" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Project.ExternalCost, StringFormat='\{0:N0\}'}"/>
                                                    <Setter Property="Foreground" Value="#c05621"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Project.ExternalCost}" Value="0">
                                                            <Setter Property="Text" Value="-"/>
                                                            <Setter Property="Foreground" Value="#a0aec0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Paydaşlar -->
                            <DataGridTextColumn Header="Paydaşlar" Binding="{Binding Project.Stakeholders}" Width="1.2*"/>

                            <!-- İşlemler Button (Visible only for Admin & Analysts) -->
                            <DataGridTemplateColumn Header="İşlem" Width="100" Visibility="{Binding DataContext.CreateProjectButtonVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectsView}}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✏️ Düzenle" Height="26" Padding="10,0" FontSize="11" 
                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectsView}}}"
                                                CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- ROW DETAILS TEMPLATE: DETAILED PERSON & MONTH BREAKDOWN PANEL -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="15" Margin="8,4,8,12">
                                    <StackPanel>
                                        <!-- Header inside Detail -->
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔍 PROJE DETAYLI ADAM/GÜN DAĞILIMI:" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource ZiraatRed}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Project.ProjectName, StringFormat=' {0}'}" FontWeight="Bold" FontSize="12.5" Foreground="#0f172a" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Project.PergelNo, StringFormat=' (Pergel No: {0})'}" FontSize="11.5" Foreground="#64748b" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Column: Person & Month Table -->
                                            <Border Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="📋 Personel ve Ay Bazlı Dağılım Matrisi" FontWeight="Bold" FontSize="11.5" Foreground="#1e40af" Margin="0,0,0,6"/>
                                                    
                                                    <DataGrid ItemsSource="{Binding UserBreakdownList}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="60"
                                                              helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True">
                                                        <DataGrid.Columns>
                                                            <!-- Personel Name & Role (220px fixed width so name is always fully visible) -->
                                                            <DataGridTemplateColumn Header="Personel (Unvan)" Width="220">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="#0f172a" FontSize="11.5"/>
                                                                            <TextBlock Text="{Binding Role, StringFormat=' ({0})'}" FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            
                                                            <DataGridTextColumn Header="{Binding Data.Month1Header, Source={StaticResource DataContextProxy}}" 
                                                                                Binding="{Binding Month1ManDays, StringFormat=\{0:N0\}}" Width="75"/>

                                                            <DataGridTextColumn Header="{Binding Data.Month2Header, Source={StaticResource DataContextProxy}}" 
                                                                                Binding="{Binding Month2ManDays, StringFormat=\{0:N0\}}" Width="75"/>

                                                            <DataGridTextColumn Header="{Binding Data.Month3Header, Source={StaticResource DataContextProxy}}" 
                                                                                Binding="{Binding Month3ManDays, StringFormat=\{0:N0\}}" Width="75"/>

                                                            <DataGridTextColumn Header="Toplam" Binding="{Binding TotalManDays, StringFormat=\{0:N0\}}" Width="70" FontWeight="Bold"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right Column: Additional Project Summary Info -->
                                            <Border Grid.Column="1" Background="#f1f5f9" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="10,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="📌 Ek Proje Bilgileri" FontWeight="Bold" FontSize="11.5" Foreground="#334155" Margin="0,0,0,8"/>

                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock Text="🏛️ GMY (Genel Müdür Yardımcılığı):" FontWeight="SemiBold" FontSize="11" Foreground="#64748b"/>
                                                        <TextBlock Text="{Binding Project.Gmy, TargetNullValue='-'}" FontWeight="Bold" FontSize="11.5" Foreground="#0f172a" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock Text="🏢 İş Birimi (Bölüm Başkanlığı):" FontWeight="SemiBold" FontSize="11" Foreground="#64748b"/>
                                                        <TextBlock Text="{Binding Project.BusinessUnit, TargetNullValue='-'}" FontWeight="Bold" FontSize="11.5" Foreground="#0f172a" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock Text="👥 Paydaş Departmanlar:" FontWeight="SemiBold" FontSize="11" Foreground="#64748b"/>
                                                        <TextBlock Text="{Binding Project.Stakeholders}" FontWeight="Bold" FontSize="11.5" Foreground="#0f172a" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock Text="💰 Dış Maliyet:" FontWeight="SemiBold" FontSize="11" Foreground="#64748b"/>
                                                        <TextBlock Text="{Binding Project.ExternalCost, StringFormat='\{0:N0\}'}" FontWeight="Bold" FontSize="11.5" Foreground="#c05621"/>
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <TextBlock Text="📝 Açıklama / Notlar:" FontWeight="SemiBold" FontSize="11" Foreground="#64748b"/>
                                                        <TextBlock Text="{Binding Project.Description}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- MODAL OVERLAY DIALOG FOR CREATE / EDIT REQUEST -->
        <Grid x:Name="ModalGrid" Visibility="{Binding FormVisibility}" Background="#70000000">
            <Border Background="White" CornerRadius="12" Width="760" MaxHeight="720" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,15" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="{Binding FormTitleText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ZiraatRed}" VerticalAlignment="Center"/>
                        <Button Command="{Binding CloseFormCommand}" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" ToolTip="Formu Kapat">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="#fee2e2" CornerRadius="16" Width="32" Height="32">
                                        <TextBlock x:Name="txt" Text="✕" Foreground="#dc2626" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#dc2626"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Modal Form Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True" Padding="0,0,5,0">
                        <StackPanel>
                            <!-- SECTION 1: Pergel No, Ekip & Durum -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Pergel No (6-7 Hane)" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                                    <TextBox Text="{Binding PergelNo, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                    <TextBlock Text="Ait Olduğu Ekip" FontWeight="Bold" Foreground="#1e40af" Margin="0,0,0,4" FontSize="11.5"/>
                                    <ComboBox ItemsSource="{Binding TeamList}" SelectedItem="{Binding SelectedTeam}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Durum" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                                    <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding ProjectStatus}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Talep Özeti / Adı -->
                            <TextBlock Text="Talep Özeti / Proje Adı" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,12"/>

                            <!-- Proje Türü & Dış Firma -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Proje Türü" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                                    <ComboBox ItemsSource="{Binding TypeList}" SelectedItem="{Binding ProjectType}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Visibility="{Binding IsExternalCompanyVisible}" Margin="8,0,0,0">
                                    <TextBlock Text="Dış Firma Adı" FontWeight="Bold" Foreground="#c05621" Margin="0,0,0,4" FontSize="11.5"/>
                                    <TextBox Text="{Binding ExternalCompanyName, UpdateSourceTrigger=PropertyChanged}" Height="32" BorderBrush="#fbd38d" Background="#fffaf0"/>
                                </StackPanel>
                            </Grid>

                            <!-- GMY & İş Birimi Seçimi -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- GMY -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="🏛️ GMY (Genel Müdür Yardımcılığı)" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                                    <ComboBox ItemsSource="{Binding GmyList}" Text="{Binding Gmy, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="32"/>
                                </StackPanel>

                                <!-- İş Birimi -->
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="🏢 İş Birimi (Bölüm Başkanlığı)" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                                    <ComboBox ItemsSource="{Binding BusinessUnitList}" Text="{Binding BusinessUnit, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- SECTION 2: Analistler & Yazılımcılar -->
                            <Border BorderBrush="#cbd5e1" BorderThickness="1" Background="#f8fafc" CornerRadius="8" Padding="14" Margin="0,5,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Analistler -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Analistler:" FontWeight="Bold" FontSize="12" Foreground="#1e40af"/>
                                            <TextBlock Text="{Binding DisplayAnalystSummary, StringFormat='Seçim: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding AnalystUserItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding User.FullName}" Margin="0,3" FontSize="11.5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Yazılımcılar -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Yazılımcılar:" FontWeight="Bold" FontSize="12" Foreground="#065f46"/>
                                            <TextBlock Text="{Binding DisplayDeveloperSummary, StringFormat='Seçim: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#10b981" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DeveloperUserItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding User.FullName}" Margin="0,3" FontSize="11.5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SECTION 3: Çeyrek Adam-Gün Maliyet Matrisi -->
                            <Border BorderBrush="#bfdbfe" BorderThickness="1.5" Background="#eff6ff" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="🗓️ ÇEYREK AYLIK ADAM-GÜN MALİYETİ" FontWeight="Bold" FontSize="11.5" Foreground="#1e40af" Margin="0,0,0,8"/>

                                    <DataGrid ItemsSource="{Binding PersonMonthlyCostRows}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="90" MaxHeight="220" CanUserAddRows="False"
                                              helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Personel" Binding="{Binding User.FullName}" Width="1.4*" IsReadOnly="True" FontWeight="Bold"/>
                                            
                                            <!-- Dynamic Quarter Months as Editable TextBoxes -->
                                            <DataGridTemplateColumn Header="{Binding Data.Month1Header, Source={StaticResource DataContextProxy}}" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Month1ManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" 
                                                                 Height="26" Width="65" TextAlignment="Center" FontWeight="Bold"
                                                                 BorderBrush="#cbd5e1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding Data.Month2Header, Source={StaticResource DataContextProxy}}" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Month2ManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" 
                                                                 Height="26" Width="65" TextAlignment="Center" FontWeight="Bold"
                                                                 BorderBrush="#cbd5e1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding Data.Month3Header, Source={StaticResource DataContextProxy}}" Width="85">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Month3ManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" 
                                                                 Height="26" Width="65" TextAlignment="Center" FontWeight="Bold"
                                                                 BorderBrush="#cbd5e1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Toplam" Binding="{Binding TotalManDays, StringFormat=\{0:N0\}}" Width="70" IsReadOnly="True" FontWeight="Bold"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: Bütçe, Dış Maliyet & Total Summary Box -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Proje Bütçesi (Adam/Gün) -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Proje Bütçesi (Adam/Gün)" FontWeight="Bold" Foreground="#1e40af" Margin="0,0,0,4" FontSize="11.5"/>
                                    <TextBox Text="{Binding TotalManDayBudget, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" Height="32" FontWeight="Bold" Foreground="#1e40af"/>
                                </StackPanel>

                                <!-- Dış Maliyet -->
                                <StackPanel Grid.Column="1" Margin="3,0,6,0">
                                    <TextBlock Text="Dış Maliyet (TL)" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                                    <TextBox Text="{Binding ExternalCost, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                                </StackPanel>

                                <!-- Total Summary Box -->
                                <Border Grid.Column="2" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="3,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="💰 Toplam Harcanan / Bütçe:" FontSize="10.5" FontWeight="Bold" Foreground="#475569"/>
                                        <TextBlock Text="{Binding TotalProjectCostFormatted}" FontSize="12" FontWeight="ExtraBold" Foreground="#0f172a"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Dynamic Bütçe Uyarısı / Aşım Banner'ı -->
                            <Border Visibility="{Binding HasBudgetWarning, Converter={StaticResource BoolToVisConverter}}" 
                                    CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#fef2f2"/>
                                        <Setter Property="BorderBrush" Value="#fca5a5"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBudgetCritical}" Value="True">
                                                <Setter Property="Background" Value="#fffbeb"/>
                                                <Setter Property="BorderBrush" Value="#fcd34d"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BudgetWarningMessage}" FontWeight="Bold" FontSize="11.5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#dc2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBudgetCritical}" Value="True">
                                                        <Setter Property="Foreground" Value="#b45309"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: Paydaş Departmanlar -->
                            <TextBlock Text="🏢 Paydaş Departmanlar" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6" FontSize="11.5"/>
                            <ItemsControl ItemsSource="{Binding StakeholderItems}" Margin="0,0,0,15">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}" Margin="0,0,12,6" FontSize="11.5" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- SECTION 6: Genel Açıklama & Notlar -->
                            <TextBlock Text="📝 Genel Açıklama / Notlar" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="11.5"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                            <!-- Action Buttons -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding SaveButtonText}" Command="{Binding SaveProjectCommand}" Margin="0,0,6,0" Height="38"/>
                                <Button Grid.Column="1" Content="Projeyi Sil" Command="{Binding DeleteProjectCommand}" Background="#e53e3e" Margin="3,0,3,0" Height="38">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="Border" CornerRadius="5" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#fc8181"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2" Content="Vazgeç" Command="{Binding CloseFormCommand}" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Height="38"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
