                                             <ComboBox ItemsSource="{Binding FilteredEndHours}" SelectedItem="{Binding SelectedEndHour}" Height="32"/>
                                         </StackPanel>
                                     </Grid>
                                 </StackPanel>

                                <!-- Rule Box: %50 Capacity Rule -->
                                <Border BorderBrush="#cbd5e1" BorderThickness="1" Background="#f8fafc" Padding="10" Margin="0,5,0,15" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="ℹ️ İK &amp; Ekip Rol Kuralları:" FontWeight="Bold" FontSize="11" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Aynı ekipteki aynı rolün (örn. Takip Developer) %50 veya fazlası aynı tarihlerde izinliyse otomatik çakışma uyarısı verilir." FontSize="10" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Ekip üyeleri çakışan tarihlerde 'Özel İzin Talebi' oluşturabilir. İzin, yönetici onaylarsa aktifleşir." FontSize="10" Foreground="#475569" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Form Actions -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaveButtonEnabled}" Margin="0,0,5,0"/>
                                    <Button Grid.Column="1" Content="İzni Sil" Command="{Binding DeleteCommand}" Background="#e53e3e" Margin="5,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="Border" CornerRadius="5" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#fc8181"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </UserControl>
