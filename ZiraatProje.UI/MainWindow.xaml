<Window x:Class="ZiraatProje.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZiraatProje.UI"
        xmlns:viewmodels="clr-namespace:ZiraatProje.UI.ViewModels"
        xmlns:views="clr-namespace:ZiraatProje.UI.Views"
        xmlns:helpers="clr-namespace:ZiraatProje.UI.Helpers"
        mc:Ignorable="d" 
        Title="Ziraat Matrix - Ekip İçi Yönetim Sistemi" 
        Icon="/Assets/ziraat_logo.png"
        Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#fcfbfa">

    <Window.Resources>
        <!-- Mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:UsersViewModel}">
            <views:UsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ShiftsViewModel}">
            <views:ShiftsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:LeavesViewModel}">
            <views:LeavesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProjectsViewModel}">
            <views:ProjectsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>

        <!-- Custom Top Horizontal Menu Radio Button Styling (Centered Icons) -->
        <Style x:Key="TopHorizontalMenuButton" TargetType="RadioButton">
            <Setter Property="Height" Value="55"/>
            <Setter Property="MinWidth" Value="155"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="Border" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="28" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SoftPink}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ZiraatRed}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource ZiraatRed}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Burgundy}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- 1. MAIN APPLICATION WORKSPACE -->
        <Grid Name="MainWorkspace">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            
            <Grid.RowDefinitions>
                <!-- Row 0: Editorial Top Banner Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Centered Horizontal Buttons Menu Row -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: View content host canvas -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header Banner with Animated Background (Clickable to Navigate to Ana Sayfa) -->
            <Grid Grid.Row="0" Height="85" ClipToBounds="True">
                <!-- Rich black editorial background (Crimson Noir Contrast) -->
                <Grid.Background>
                    <SolidColorBrush Color="#000000"/>
                </Grid.Background>

                <!-- Dynamic fluid background shapes (layered animated wavy silk lines and volumetric glow) -->
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.95">
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Silk Line 1 (Top Wave) Translate & Rotate -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk1Trans" Storyboard.TargetProperty="X" From="-80" To="80" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk1Trans" Storyboard.TargetProperty="Y" From="-8" To="8" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk1Rot" Storyboard.TargetProperty="Angle" From="-6" To="6" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Silk Line 2 (Upper-Mid) Translate & Rotate -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk2Trans" Storyboard.TargetProperty="X" From="70" To="-70" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk2Trans" Storyboard.TargetProperty="Y" From="-6" To="6" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk2Rot" Storyboard.TargetProperty="Angle" From="4" To="-4" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Silk Line 3 (Lower-Mid) Translate & Rotate -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk3Trans" Storyboard.TargetProperty="X" From="-50" To="50" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk3Trans" Storyboard.TargetProperty="Y" From="-10" To="10" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk3Rot" Storyboard.TargetProperty="Angle" From="-8" To="8" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Silk Line 4 (Bottom Wave) Translate & Rotate -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk4Trans" Storyboard.TargetProperty="X" From="60" To="-60" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk4Trans" Storyboard.TargetProperty="Y" From="-7" To="7" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk4Rot" Storyboard.TargetProperty="Angle" From="-5" To="5" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Silk Line 5 (Diagonal 1) Translate & Rotate -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk5Trans" Storyboard.TargetProperty="X" From="-40" To="40" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk5Trans" Storyboard.TargetProperty="Y" From="-12" To="12" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk5Rot" Storyboard.TargetProperty="Angle" From="-15" To="-5" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Silk Line 6 (Diagonal 2) Translate & Rotate -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk6Trans" Storyboard.TargetProperty="X" From="30" To="-30" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk6Trans" Storyboard.TargetProperty="Y" From="-8" To="8" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderSilk6Rot" Storyboard.TargetProperty="Angle" From="5" To="15" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Glowing Circle 1 (Drift) -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowCircle1Transform" Storyboard.TargetProperty="X" From="-25" To="25" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowCircle1Transform" Storyboard.TargetProperty="Y" From="-10" To="10" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Glowing Circle 2 (Drift) -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowCircle2Transform" Storyboard.TargetProperty="X" From="30" To="-30" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowCircle2Transform" Storyboard.TargetProperty="Y" From="-10" To="10" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Breathing Center Glow -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderCenterGlowTransform" Storyboard.TargetProperty="ScaleX" From="0.85" To="1.15" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderCenterGlowTransform" Storyboard.TargetProperty="ScaleY" From="0.85" To="1.15" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever"/>

                                    <!-- Sync Glow lines to float with their corresponding silk lines -->
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowLine1Trans" Storyboard.TargetProperty="X" From="-80" To="80" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowLine1Trans" Storyboard.TargetProperty="Y" From="-8" To="8" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowLine2Trans" Storyboard.TargetProperty="X" From="60" To="-60" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowLine2Trans" Storyboard.TargetProperty="Y" From="-7" To="7" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowLine3Trans" Storyboard.TargetProperty="X" From="-40" To="40" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderGlowLine3Trans" Storyboard.TargetProperty="Y" From="-12" To="12" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>

                    <!-- Static ambient glow in background -->
                    <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-80,0" Stretch="Fill">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="HeaderGlowCircle1Transform" X="0" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#40C50337" Offset="0.0"/>
                                <GradientStop Color="#00C50337" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-100,0,0,0" Stretch="Fill">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="HeaderGlowCircle2Transform" X="0" Y="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#30ff8478" Offset="0.0"/>
                                <GradientStop Color="#00ff8478" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="300" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="HeaderCenterGlowTransform" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#35960018" Offset="0.0"/>
                                <GradientStop Color="#00960018" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- VOLUMETRIC GLOW LINES -->
                    <Path Height="45" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0.2 C 0.25,0.8 0.5,-0.2 0.75,0.6 C 0.85,0.9 0.95,0.2 1,0.3" StrokeThickness="16">
                        <Path.Effect>
                            <BlurEffect Radius="30"/>
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="HeaderGlowLine1Trans" X="0" Y="0"/>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00C50337" Offset="0.0"/>
                                <GradientStop Color="#35C50337" Offset="0.3"/>
                                <GradientStop Color="#55C50337" Offset="0.5"/>
                                <GradientStop Color="#25ff8478" Offset="0.8"/>
                                <GradientStop Color="#00C50337" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <Path Height="55" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0.8 C 0.25,0.2 0.5,0.9 0.75,0.4 C 0.85,0.1 0.95,0.7 1,0.5" StrokeThickness="18">
                        <Path.Effect>
                            <BlurEffect Radius="35"/>
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="HeaderGlowLine2Trans" X="0" Y="0"/>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00ff8478" Offset="0.0"/>
                                <GradientStop Color="#40ff8478" Offset="0.4"/>
                                <GradientStop Color="#20cb4c46" Offset="0.7"/>
                                <GradientStop Color="#00ff8478" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <Path Width="1000" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0 C 0.3,0.6 0.7,0.4 1,1" StrokeThickness="14">
                        <Path.Effect>
                            <BlurEffect Radius="25"/>
                        </Path.Effect>
                        <Path.RenderTransform>
                            <TranslateTransform x:Name="HeaderGlowLine3Trans" X="0" Y="0"/>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00C50337" Offset="0.0"/>
                                <GradientStop Color="#30C50337" Offset="0.5"/>
                                <GradientStop Color="#00cb4c46" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <!-- CRISP SILK LINES -->
                    <Path Height="45" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0.2 C 0.25,0.8 0.5,-0.2 0.75,0.6 C 0.85,0.9 0.95,0.2 1,0.3" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="HeaderSilk1Trans" X="0" Y="0"/>
                                <RotateTransform x:Name="HeaderSilk1Rot" Angle="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00C50337" Offset="0.0"/>
                                <GradientStop Color="#88C50337" Offset="0.2"/>
                                <GradientStop Color="#FFE52D35" Offset="0.5"/>
                                <GradientStop Color="#FFFF9F43" Offset="0.75"/>
                                <GradientStop Color="#88C50337" Offset="0.9"/>
                                <GradientStop Color="#00C50337" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <Path Height="55" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0.6 C 0.2,0.1 0.4,0.9 0.6,0.3 C 0.8,0.1 0.9,0.7 1,0.5" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="HeaderSilk2Trans" X="0" Y="0"/>
                                <RotateTransform x:Name="HeaderSilk2Rot" Angle="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00cb4c46" Offset="0.0"/>
                                <GradientStop Color="#99cb4c46" Offset="0.3"/>
                                <GradientStop Color="#FFFF8478" Offset="0.6"/>
                                <GradientStop Color="#99C50337" Offset="0.8"/>
                                <GradientStop Color="#00cb4c46" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <Path Height="50" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0.3 C 0.3,0.8 0.6,-0.1 1,0.7" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="HeaderSilk3Trans" X="0" Y="0"/>
                                <RotateTransform x:Name="HeaderSilk3Rot" Angle="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00C50337" Offset="0.0"/>
                                <GradientStop Color="#AAff8478" Offset="0.4"/>
                                <GradientStop Color="#FFFF9F43" Offset="0.7"/>
                                <GradientStop Color="#88cb4c46" Offset="0.9"/>
                                <GradientStop Color="#00C50337" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <Path Height="60" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0.8 C 0.25,0.2 0.5,0.9 0.75,0.4 C 0.85,0.1 0.95,0.7 1,0.5" StrokeThickness="1.8" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="HeaderSilk4Trans" X="0" Y="0"/>
                                <RotateTransform x:Name="HeaderSilk4Rot" Angle="0"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00ff8478" Offset="0.0"/>
                                <GradientStop Color="#99ff8478" Offset="0.2"/>
                                <GradientStop Color="#FFE52D35" Offset="0.5"/>
                                <GradientStop Color="#FFFF8478" Offset="0.8"/>
                                <GradientStop Color="#00ff8478" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <Path Width="1000" Height="75" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,0 C 0.3,0.6 0.7,0.4 1,1" StrokeThickness="1.0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="HeaderSilk5Trans" X="0" Y="0"/>
                                <RotateTransform x:Name="HeaderSilk5Rot" Angle="-10"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00C50337" Offset="0.0"/>
                                <GradientStop Color="#88C50337" Offset="0.3"/>
                                <GradientStop Color="#FFE52D35" Offset="0.6"/>
                                <GradientStop Color="#FFFF9F43" Offset="0.85"/>
                                <GradientStop Color="#00C50337" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>

                    <Path Width="1000" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" Margin="-100,0,-100,0" Data="M 0,1 C 0.3,0.4 0.7,0.6 1,0" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="HeaderSilk6Trans" X="0" Y="0"/>
                                <RotateTransform x:Name="HeaderSilk6Rot" Angle="10"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00ff8478" Offset="0.0"/>
                                <GradientStop Color="#77ff8478" Offset="0.2"/>
                                <GradientStop Color="#FFE52D35" Offset="0.5"/>
                                <GradientStop Color="#FFFF8478" Offset="0.8"/>
                                <GradientStop Color="#00ff8478" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                </Grid>

                <!-- Overlay to fade out lines in the middle for maximum text readability -->
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0.0"/>
                            <GradientStop Color="#00000000" Offset="0.22"/>
                            <GradientStop Color="#FF000000" Offset="0.38"/>
                            <GradientStop Color="#FF000000" Offset="0.62"/>
                            <GradientStop Color="#00000000" Offset="0.78"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Row 0 Content (Clickable to Navigate to Ana Sayfa) -->
            <Border Grid.Row="0" Background="Transparent" Padding="30,16" CornerRadius="0" Cursor="Hand" ToolTip="Ana Sayfaya Git">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ShowDashboardCommand}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Logo and Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True">
                            <Image Source="/Assets/ziraat_logo.png" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ZİRAAT MATRIX" Foreground="White" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Ekip İçi Yönetim Sistemi" Foreground="{StaticResource SoftPink}" FontSize="11.5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- User Greetings & Active Role Context -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserName, StringFormat='Merhaba, \{0\}!'}" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUserTitle}" Foreground="{StaticResource SoftPink}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Log out button -->
                    <Button Grid.Column="2" Content="Oturumu Kapat ↩" Command="{Binding LogoutCommand}" Width="130" Height="34" Cursor="Hand" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="17" Background="#bc171d" BorderBrush="#fae3e3" BorderThickness="0.5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Row 1: Horizontal Navigation Bar (Centered Icon Buttons) -->
            <Border Grid.Row="1" Background="#F0EDE6" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="0,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton Style="{StaticResource TopHorizontalMenuButton}" GroupName="TopNavGroup" IsChecked="{Binding IsDashboardActive, Mode=OneWay}" Command="{Binding ShowDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Ana Sayfa" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource TopHorizontalMenuButton}" GroupName="TopNavGroup" IsChecked="{Binding IsUsersActive, Mode=OneWay}" Command="{Binding ShowUsersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥 " FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Kullanıcı Yönetimi" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource TopHorizontalMenuButton}" GroupName="TopNavGroup" IsChecked="{Binding IsShiftsActive, Mode=OneWay}" Command="{Binding ShowShiftsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 " FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Nöbet Takvimi" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource TopHorizontalMenuButton}" GroupName="TopNavGroup" IsChecked="{Binding IsLeavesActive, Mode=OneWay}" Command="{Binding ShowLeavesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌴 " FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="İzin Planlama" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource TopHorizontalMenuButton}" GroupName="TopNavGroup" IsChecked="{Binding IsProjectsActive, Mode=OneWay}" Command="{Binding ShowProjectsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💼 " FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Proje &amp; Bütçe" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource TopHorizontalMenuButton}" GroupName="TopNavGroup" IsChecked="{Binding IsChatActive, Mode=OneWay}" Command="{Binding ShowChatCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💬 " FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Chat" FontSize="13" VerticalAlignment="Center"/>
                            <Border Visibility="{Binding ChatUnreadBadgeVisibility}" Background="#10b981" CornerRadius="12" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟢 " FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UnreadChatCount, StringFormat='{}{0} YENİ'}" Foreground="White" FontSize="10" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Row 2: MAIN VIEW CONTENT CANVAS (WITH SMOOTH MOUSE WHEEL SCROLLING) -->
            <ScrollViewer Grid.Row="2" Background="#F0EDE6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="0"/>
            </ScrollViewer>
        </Grid>

        <!-- 2. HIGH-FASHION LOGIN INPUT OVERLAY -->
        <Grid Name="LoginSelector">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Rich black editorial background (Crimson Noir Contrast) -->
            <Grid.Background>
                <SolidColorBrush Color="#000000"/>
            </Grid.Background>

            <!-- Dynamic fluid background shapes (layered animated wavy silk lines and volumetric glow) -->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.95">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Silk Line 1 (Top Wave) Translate & Rotate -->
                                <DoubleAnimation Storyboard.TargetName="Silk1Trans" Storyboard.TargetProperty="X" From="-80" To="80" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk1Trans" Storyboard.TargetProperty="Y" From="-20" To="20" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk1Rot" Storyboard.TargetProperty="Angle" From="-6" To="6" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Silk Line 2 (Upper-Mid) Translate & Rotate -->
                                <DoubleAnimation Storyboard.TargetName="Silk2Trans" Storyboard.TargetProperty="X" From="70" To="-70" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk2Trans" Storyboard.TargetProperty="Y" From="15" To="-15" Duration="0:0:11" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk2Rot" Storyboard.TargetProperty="Angle" From="4" To="-4" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Silk Line 3 (Lower-Mid) Translate & Rotate -->
                                <DoubleAnimation Storyboard.TargetName="Silk3Trans" Storyboard.TargetProperty="X" From="-50" To="50" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk3Trans" Storyboard.TargetProperty="Y" From="-25" To="25" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk3Rot" Storyboard.TargetProperty="Angle" From="-8" To="8" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Silk Line 4 (Bottom Wave) Translate & Rotate -->
                                <DoubleAnimation Storyboard.TargetName="Silk4Trans" Storyboard.TargetProperty="X" From="60" To="-60" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk4Trans" Storyboard.TargetProperty="Y" From="-15" To="15" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk4Rot" Storyboard.TargetProperty="Angle" From="-5" To="5" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Silk Line 5 (Diagonal 1) Translate & Rotate -->
                                <DoubleAnimation Storyboard.TargetName="Silk5Trans" Storyboard.TargetProperty="X" From="-40" To="40" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk5Trans" Storyboard.TargetProperty="Y" From="-30" To="30" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk5Rot" Storyboard.TargetProperty="Angle" From="-15" To="-5" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Silk Line 6 (Diagonal 2) Translate & Rotate -->
                                <DoubleAnimation Storyboard.TargetName="Silk6Trans" Storyboard.TargetProperty="X" From="30" To="-30" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk6Trans" Storyboard.TargetProperty="Y" From="-20" To="20" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="Silk6Rot" Storyboard.TargetProperty="Angle" From="5" To="15" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Glowing Circle 1 (Drift) -->
                                <DoubleAnimation Storyboard.TargetName="GlowCircle1Transform" Storyboard.TargetProperty="X" From="-35" To="35" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="GlowCircle1Transform" Storyboard.TargetProperty="Y" From="-30" To="30" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Glowing Circle 2 (Drift) -->
                                <DoubleAnimation Storyboard.TargetName="GlowCircle2Transform" Storyboard.TargetProperty="X" From="40" To="-40" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="GlowCircle2Transform" Storyboard.TargetProperty="Y" From="-20" To="20" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Breathing Center Glow -->
                                <DoubleAnimation Storyboard.TargetName="CenterGlowTransform" Storyboard.TargetProperty="ScaleX" From="0.85" To="1.15" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="CenterGlowTransform" Storyboard.TargetProperty="ScaleY" From="0.85" To="1.15" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever"/>

                                <!-- Sync Glow lines to float with their corresponding silk lines -->
                                <DoubleAnimation Storyboard.TargetName="GlowLine1Trans" Storyboard.TargetProperty="X" From="-80" To="80" Duration="0:0:14" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="GlowLine1Trans" Storyboard.TargetProperty="Y" From="-20" To="20" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="GlowLine2Trans" Storyboard.TargetProperty="X" From="60" To="-60" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="GlowLine2Trans" Storyboard.TargetProperty="Y" From="-15" To="15" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="GlowLine3Trans" Storyboard.TargetProperty="X" From="-40" To="40" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetName="GlowLine3Trans" Storyboard.TargetProperty="Y" From="-30" To="30" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <!-- Static ambient glow in background -->
                <!-- Floating Accent Circle Top-Right (Vivid Crimson Glow) -->
                <Ellipse Width="550" Height="550" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-180,0" Stretch="Fill">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="GlowCircle1Transform" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#40C50337" Offset="0.0"/>
                            <GradientStop Color="#00C50337" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Floating Accent Circle Bottom-Left (Vivid Peach Glow) -->
                <Ellipse Width="650" Height="650" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-250" Stretch="Fill">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="GlowCircle2Transform" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#30ff8478" Offset="0.0"/>
                            <GradientStop Color="#00ff8478" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Central Breathing Glow (Deep Red) -->
                <Ellipse Width="500" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CenterGlowTransform" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#35960018" Offset="0.0"/>
                            <GradientStop Color="#00960018" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- VOLUMETRIC GLOW LINES (Thick blurred wave paths to create smoke/nebula volumetric light) -->
                <!-- Glow Wave Top -->
                <Path Height="220" VerticalAlignment="Top" Stretch="Fill" Margin="-200,80,-200,0" Data="M 0,0.2 C 0.25,0.8 0.5,-0.2 0.75,0.6 C 0.85,0.9 0.95,0.2 1,0.3" StrokeThickness="24">
                    <Path.Effect>
                        <BlurEffect Radius="45"/>
                    </Path.Effect>
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="GlowLine1Trans" X="0" Y="0"/>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C50337" Offset="0.0"/>
                            <GradientStop Color="#35C50337" Offset="0.3"/>
                            <GradientStop Color="#55C50337" Offset="0.5"/>
                            <GradientStop Color="#25ff8478" Offset="0.8"/>
                            <GradientStop Color="#00C50337" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Glow Wave Bottom -->
                <Path Height="240" VerticalAlignment="Bottom" Stretch="Fill" Margin="-200,0,-200,40" Data="M 0,0.8 C 0.25,0.2 0.5,0.9 0.75,0.4 C 0.85,0.1 0.95,0.7 1,0.5" StrokeThickness="28">
                    <Path.Effect>
                        <BlurEffect Radius="50"/>
                    </Path.Effect>
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="GlowLine2Trans" X="0" Y="0"/>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00ff8478" Offset="0.0"/>
                            <GradientStop Color="#40ff8478" Offset="0.4"/>
                            <GradientStop Color="#20cb4c46" Offset="0.7"/>
                            <GradientStop Color="#00ff8478" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Glow Wave Diagonal -->
                <Path Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" Margin="-350,-350,-350,-350" Data="M 0,0 C 0.3,0.6 0.7,0.4 1,1" StrokeThickness="20">
                    <Path.Effect>
                        <BlurEffect Radius="40"/>
                    </Path.Effect>
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="GlowLine3Trans" X="0" Y="0"/>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00C50337" Offset="0.0"/>
                            <GradientStop Color="#30C50337" Offset="0.5"/>
                            <GradientStop Color="#00cb4c46" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>


                <!-- CRISP SILK LINES (Thin, glowing high-contrast curves to make the hair-like silk wave mesh) -->
                <!-- Silk Line 1 (Top Wave) -->
                <Path Height="220" VerticalAlignment="Top" Stretch="Fill" Margin="-200,80,-200,0" Data="M 0,0.2 C 0.25,0.8 0.5,-0.2 0.75,0.6 C 0.85,0.9 0.95,0.2 1,0.3" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Silk1Trans" X="0" Y="0"/>
                            <RotateTransform x:Name="Silk1Rot" Angle="0"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C50337" Offset="0.0"/>
                            <GradientStop Color="#88C50337" Offset="0.2"/>
                            <GradientStop Color="#FFE52D35" Offset="0.5"/>
                            <GradientStop Color="#FFFF9F43" Offset="0.75"/>
                            <GradientStop Color="#88C50337" Offset="0.9"/>
                            <GradientStop Color="#00C50337" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Silk Line 2 (Upper-Mid) -->
                <Path Height="260" VerticalAlignment="Top" Stretch="Fill" Margin="-200,200,-200,0" Data="M 0,0.6 C 0.2,0.1 0.4,0.9 0.6,0.3 C 0.8,0.1 0.9,0.7 1,0.5" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Silk2Trans" X="0" Y="0"/>
                            <RotateTransform x:Name="Silk2Rot" Angle="0"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00cb4c46" Offset="0.0"/>
                            <GradientStop Color="#99cb4c46" Offset="0.3"/>
                            <GradientStop Color="#FFFF8478" Offset="0.6"/>
                            <GradientStop Color="#99C50337" Offset="0.8"/>
                            <GradientStop Color="#00cb4c46" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Silk Line 3 (Lower-Mid) -->
                <Path Height="280" VerticalAlignment="Bottom" Stretch="Fill" Margin="-200,0,-200,160" Data="M 0,0.3 C 0.3,0.8 0.6,-0.1 1,0.7" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Silk3Trans" X="0" Y="0"/>
                            <RotateTransform x:Name="Silk3Rot" Angle="0"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00C50337" Offset="0.0"/>
                            <GradientStop Color="#AAff8478" Offset="0.4"/>
                            <GradientStop Color="#FFFF9F43" Offset="0.7"/>
                            <GradientStop Color="#88cb4c46" Offset="0.9"/>
                            <GradientStop Color="#00C50337" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Silk Line 4 (Bottom Wave) -->
                <Path Height="240" VerticalAlignment="Bottom" Stretch="Fill" Margin="-200,0,-200,40" Data="M 0,0.8 C 0.25,0.2 0.5,0.9 0.75,0.4 C 0.85,0.1 0.95,0.7 1,0.5" StrokeThickness="1.8" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Silk4Trans" X="0" Y="0"/>
                            <RotateTransform x:Name="Silk4Rot" Angle="0"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00ff8478" Offset="0.0"/>
                            <GradientStop Color="#99ff8478" Offset="0.2"/>
                            <GradientStop Color="#FFE52D35" Offset="0.5"/>
                            <GradientStop Color="#FFFF8478" Offset="0.8"/>
                            <GradientStop Color="#00ff8478" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Silk Line 5 (Diagonal 1) -->
                <Path Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" Margin="-350,-350,-350,-350" Data="M 0,0 C 0.3,0.6 0.7,0.4 1,1" StrokeThickness="1.0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Silk5Trans" X="0" Y="0"/>
                            <RotateTransform x:Name="Silk5Rot" Angle="-10"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00C50337" Offset="0.0"/>
                            <GradientStop Color="#88C50337" Offset="0.3"/>
                            <GradientStop Color="#FFE52D35" Offset="0.6"/>
                            <GradientStop Color="#FFFF9F43" Offset="0.85"/>
                            <GradientStop Color="#00C50337" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>

                <!-- Silk Line 6 (Diagonal 2) -->
                <Path Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Fill" Margin="-350,-350,-350,-350" Data="M 0,1 C 0.3,0.4 0.7,0.6 1,0" StrokeThickness="1.2" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="Silk6Trans" X="0" Y="0"/>
                            <RotateTransform x:Name="Silk6Rot" Angle="10"/>
                        </TransformGroup>
                    </Path.RenderTransform>
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00ff8478" Offset="0.0"/>
                            <GradientStop Color="#77ff8478" Offset="0.2"/>
                            <GradientStop Color="#FFE52D35" Offset="0.5"/>
                            <GradientStop Color="#FFFF8478" Offset="0.8"/>
                            <GradientStop Color="#00ff8478" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            </Grid>

            <!-- 1. Ambient Background Light Halo (Outer Red-Gold Glow Aura) -->
            <Border Width="454" Height="484" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="85" Color="#BC171D" Opacity="0.9" ShadowDepth="0"/>
                </Border.Effect>
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#A0BC171D" Offset="0.0"/>
                        <GradientStop Color="#40FF4D5A" Offset="0.6"/>
                        <GradientStop Color="#00BC171D" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 2. Under-Glow Light Bar (Glowing Bottom Light Accent) -->
            <Border Width="380" Height="10" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,470,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00FF3B47" Offset="0.0"/>
                        <GradientStop Color="#FFFF3B47" Offset="0.25"/>
                        <GradientStop Color="#FFFF8478" Offset="0.5"/>
                        <GradientStop Color="#FFFF3B47" Offset="0.75"/>
                        <GradientStop Color="#00FF3B47" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#FF3B47" Opacity="0.95" ShadowDepth="0"/>
                </Border.Effect>
            </Border>

            <!-- 3. Centered Login Container with Cream-Gray Gradient & Glowing Edges -->
            <Border Width="440" Height="Auto" MinHeight="470" CornerRadius="16" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0,15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FAF8F5" Offset="0.0"/>
                        <GradientStop Color="#F0EDE6" Offset="0.5"/>
                        <GradientStop Color="#E5E2DC" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFF3B47" Offset="0.0"/>
                        <GradientStop Color="#FFBC171D" Offset="0.3"/>
                        <GradientStop Color="#FFFF8478" Offset="0.7"/>
                        <GradientStop Color="#FFFF3B47" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45" Color="#BC171D" Opacity="0.75" ShadowDepth="0"/>
                </Border.Effect>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Brand Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,15">
                        <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#bc171d" Opacity="0.3" ShadowDepth="1" Direction="270"/>
                            </Border.Effect>
                            <Image Source="/Assets/ziraat_logo.png" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="ZİRAAT MATRIX" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Burgundy}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ekip İçi Yönetim Sistemi" FontSize="11.5" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="#D5D2CC" Margin="0,0,0,15"/>

                    <!-- 1. NORMAL LOGIN PANEL -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Width="340" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResetPasswordMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="GÜVENLİ GİRİŞ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Burgundy}" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                        <!-- Email -->
                        <TextBlock Text="Kurumsal E-Posta" FontSize="12" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                        <Grid Height="38" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding LoginEmailPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EmailPrefixTextBoxStyle}" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0"/>

                            <Border Grid.Column="1" Background="#EFECE6" BorderBrush="#CBD5E0" BorderThickness="0,1,1,1" Padding="14,0" CornerRadius="0,5,5,0">
                                <TextBlock Text="@ziraatteknoloji.com" FontSize="12" FontWeight="Bold" Foreground="#718096" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Password -->
                        <TextBlock Text="Şifre" FontSize="12" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16" Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Masked PasswordBox -->
                            <PasswordBox Grid.Column="0" Name="TxtPassword" PasswordChanged="TxtPassword_PasswordChanged" IsVisibleChanged="TxtPassword_IsVisibleChanged" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowLoginPasswordText}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <!-- Plain Text TextBox -->
                            <TextBox Grid.Column="0" Text="{Binding LoginPassword, UpdateSourceTrigger=PropertyChanged}" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowLoginPasswordText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- Eye Button -->
                            <Button Grid.Column="1" Command="{Binding ToggleShowLoginPasswordCommand}" Content="{Binding LoginEyeIcon}" Width="38" Height="38" Margin="6,0,0,0" Background="#EFECE6" BorderBrush="#CBD5E0" BorderThickness="1" Foreground="#718096" FontSize="13" Cursor="Hand" ToolTip="Şifreyi Göster / Gizle">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Name="Border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#DEDBD3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Error Message Block -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ZiraatRed}" FontWeight="Bold" FontSize="11" Margin="0,0,0,12" HorizontalAlignment="Center"/>

                        <!-- Login Button -->
                        <Button Style="{StaticResource NormalLoginButton}" Content="Giriş Yap" Command="{Binding LoginCommand}" Height="40"/>

                        <!-- Forgot Password / First Login Link Button -->
                        <Button Style="{StaticResource LinkButton}" Content="🔑 Şifremi Unuttum / İlk Giriş Şifre Yenileme" Command="{Binding ShowResetPasswordCommand}" Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="{StaticResource ZiraatRed}"/>
                    </StackPanel>

                    <!-- 2. PASSWORD RESET PANEL -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Width="340" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResetPasswordMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="ŞİFRE YENİLEME &amp; İLK GİRİŞ" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Burgundy}" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                        <!-- Email -->
                        <TextBlock Text="Kurumsal E-Posta" FontSize="12" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                        <Grid Height="38" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding ResetEmailPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EmailPrefixTextBoxStyle}" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0"/>

                            <Border Grid.Column="1" Background="#EFECE6" BorderBrush="#CBD5E0" BorderThickness="0,1,1,1" Padding="14,0" CornerRadius="0,5,5,0">
                                <TextBlock Text="@ziraatteknoloji.com" FontSize="12" FontWeight="Bold" Foreground="#718096" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Phone -->
                        <TextBlock Text="Kayıtlı Telefon Numarası (Doğrulama İçin)" FontSize="12" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ResetPhone, UpdateSourceTrigger=PropertyChanged}" KeyDown="Input_KeyDown" Height="38" Margin="0,0,0,12" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0"/>

                        <!-- New Password -->
                        <TextBlock Text="Yeni Şifre" FontSize="12" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12" Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Masked PasswordBox -->
                            <PasswordBox Grid.Column="0" Name="TxtNewPassword" PasswordChanged="TxtNewPassword_PasswordChanged" IsVisibleChanged="TxtNewPassword_IsVisibleChanged" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowResetPasswordText}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <!-- Plain Text TextBox -->
                            <TextBox Grid.Column="0" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowResetPasswordText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- Eye Button -->
                            <Button Grid.Column="1" Command="{Binding ToggleShowResetPasswordCommand}" Content="{Binding EyeIcon}" Width="38" Height="38" Margin="6,0,0,0" Background="#EFECE6" BorderBrush="#CBD5E0" BorderThickness="1" Foreground="#718096" FontSize="13" Cursor="Hand" ToolTip="Şifreyi Göster / Gizle">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Name="Border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#DEDBD3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Confirm New Password -->
                        <TextBlock Text="Yeni Şifre (Tekrar)" FontSize="12" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12" Height="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Masked PasswordBox -->
                            <PasswordBox Grid.Column="0" Name="TxtNewPasswordConfirm" PasswordChanged="TxtNewPasswordConfirm_PasswordChanged" IsVisibleChanged="TxtNewPasswordConfirm_IsVisibleChanged" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowResetPasswordText}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <!-- Plain Text TextBox -->
                            <TextBox Grid.Column="0" Text="{Binding NewPasswordConfirm, UpdateSourceTrigger=PropertyChanged}" KeyDown="Input_KeyDown" Height="38" VerticalContentAlignment="Center" FontSize="13" Padding="12,0" Background="White" Foreground="{StaticResource DarkSlate}" BorderBrush="#CBD5E0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowResetPasswordText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- Eye Button -->
                            <Button Grid.Column="1" Command="{Binding ToggleShowResetPasswordCommand}" Content="{Binding EyeIcon}" Width="38" Height="38" Margin="6,0,0,0" Background="#EFECE6" BorderBrush="#CBD5E0" BorderThickness="1" Foreground="#718096" FontSize="13" Cursor="Hand" ToolTip="Şifreyi Göster / Gizle">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Name="Border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#DEDBD3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Reset Status Message Block -->
                        <TextBlock Text="{Binding ResetStatusMessage}" Foreground="{StaticResource ZiraatRed}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8" HorizontalAlignment="Center" TextWrapping="Wrap"/>

                        <!-- Submit & Cancel Buttons -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Şifreyi Güncelle" Command="{Binding SubmitResetPasswordCommand}" Style="{StaticResource NormalLoginButton}" Height="38" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="İptal / Giriş" Command="{Binding CancelResetPasswordCommand}" Background="#718096" Foreground="White" FontWeight="Bold" Height="38" Margin="4,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Name="Border" CornerRadius="8" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#4a5568"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Footer details -->
                    <TextBlock Grid.Row="3" Text="Ziraat Teknoloji A.Ş. © 2026" FontSize="9" Foreground="{StaticResource TextGray}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
