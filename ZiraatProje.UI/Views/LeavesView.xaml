                        <!-- Right Column: Add/Edit Leave Form -->
                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="20" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="{Binding FormTitleText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ZiraatRed}" Margin="0,0,0,15"/>

                                <!-- Personel Seçimi -->
                                <TextBlock Text="Personel (Talep Sahibi)" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding UsersList}" 
                                          SelectedValue="{Binding SelectedUserId}" 
                                          SelectedValuePath="Id" 
                                          DisplayMemberPath="FullName" 
                                          IsEnabled="{Binding IsUserSelectorEnabled}"
                                          Margin="0,0,0,15"/>
                                          
                                 <!-- İzin Tipi Seçimi -->
                                 <TextBlock Text="İzin Tipi" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                                 <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                     <RadioButton Content="Tam Gün" IsChecked="{Binding IsDaily, Mode=TwoWay}" GroupName="LeaveType" Margin="0,0,20,0" FontWeight="SemiBold"/>
                                     <RadioButton Content="Saatlik" IsChecked="{Binding IsHourly, Mode=TwoWay}" GroupName="LeaveType" FontWeight="SemiBold"/>
                                 </StackPanel>

                                 <!-- Tam Gün İzin Bölümü -->
                                 <StackPanel Visibility="{Binding IsDailyVisible}">
                                     <!-- Başlangıç Tarihi -->
                                     <TextBlock Text="İzin Başlangıç Tarihi" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                                     <DatePicker SelectedDate="{Binding StartDate}" Height="32" Margin="0,0,0,15"/>

                                     <!-- Bitiş Tarihi -->
                                     <TextBlock Text="İzin Bitiş Tarihi" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                                     <DatePicker SelectedDate="{Binding EndDate}" Height="32" Margin="0,0,0,15"/>
                                 </StackPanel>

                                 <!-- Saatlik İzin Bölümü -->
                                 <StackPanel Visibility="{Binding IsHourlyVisible}">
                                     <!-- İzin Günü -->
                                     <TextBlock Text="İzin Tarihi" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                                     <DatePicker SelectedDate="{Binding HourlyDate}" Height="32" Margin="0,0,0,15"/>

                                     <!-- Saat Aralığı -->
                                     <Grid Margin="0,0,0,15">
