<UserControl x:Class="ZiraatProje.UI.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZiraatProje.UI.Views"
             xmlns:helpers="clr-namespace:ZiraatProje.UI.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <helpers:InverseBoolToVisConverter x:Key="InverseBoolToVisConverter"/>
        <helpers:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
        <helpers:BindingProxy x:Key="DataContextProxy" Data="{Binding}"/>

        <!-- Radio / Tab Button Style for Quarters -->
        <Style x:Key="QuarterButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ZiraatRed}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ZiraatRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ZiraatRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Main Page Root ScrollViewer -->
        <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True" Padding="15">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- View Header & Top Action Bar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Proje Yönetimi &amp; Çeyreklik Talep Planlaması" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Burgundy}"/>
                            <TextBlock Text="Çeyrek bazında projeleri listeleyin. Satıra tıklayarak sağ panelde detayları ve efor dağılımını inceleyin/düzenleyin." FontSize="12" Foreground="#718096" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Top Right Action Controls: Search Box & New Request Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Compact Search Box -->
                            <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" CornerRadius="6" Width="200" Height="32" Padding="6,0" Margin="0,0,10,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#64748b"/>

                                    <TextBox Grid.Column="1" 
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             BorderThickness="0" Background="Transparent" 
                                             VerticalAlignment="Center" FontSize="11" Foreground="#1e293b"
                                             ToolTip="Pergel No veya Proje Adı yazarak filtreleyin"/>

                                    <Button Grid.Column="2" Content="✕" 
                                            Command="{Binding ClearSearchCommand}" 
                                            Visibility="{Binding SearchText, Converter={StaticResource BoolToVisConverter}}" 
                                            Background="Transparent" BorderThickness="0" 
                                            Foreground="#94a3b8" FontWeight="Bold" FontSize="11" 
                                            Padding="4,0" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Main Top Button: New Request Dialog Trigger (Visible to ALL users now) -->
                            <Button Content="➕ Yeni Talep Oluştur" 
                                    Command="{Binding OpenCreateFormCommand}" 
                                    Height="32" Padding="14,0" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 🤖 AI AKILLI GELİŞTİRİCİ & EFOR ÖNERİ ASİSTANI -->
                    <Border Background="#f8fafc" BorderBrush="#7c3aed" BorderThickness="1.5" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🤖" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI Akıllı Geliştirici Atama &amp; Efor Öneri Asistanı" FontWeight="Bold" FontSize="11.5" Foreground="#1e293b" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleAiProjectCardCommand}" Padding="8,2" FontSize="10.5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="✨ En Boşta Geliştiricileri Öner"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiProjectCardExpanded}" Value="True">
                                                    <Setter Property="Content" Value="▲ Gizle"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <StackPanel Visibility="{Binding IsAiProjectCardExpanded, Converter={StaticResource BoolToVisConverter}}">
                                <!-- Ekip Seçici (kompakt) -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8" VerticalAlignment="Center">
                                    <Border Background="#ede9fe" CornerRadius="6,0,0,6" Padding="8,0" Height="28">
                                        <TextBlock Text="🏷️ Ekip" FontSize="10.5" FontWeight="Bold" Foreground="#5b21b6" VerticalAlignment="Center"/>
                                    </Border>
                                    <ComboBox ItemsSource="{Binding AiTeamFilterList}"
                                              SelectedItem="{Binding SelectedAiTeamFilter}"
                                              Width="120" Height="28"
                                              FontSize="11" Padding="6,2" Margin="0,0,8,0"
                                              BorderBrush="#c4b5fd" Background="White"/>

                                    <Button Command="{Binding GetAIProjectAllocationsCommand}" Height="28" Width="28"
                                            Background="#7c3aed" Foreground="White" FontSize="13" ToolTip="Listeyi Yenile"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#6d28d9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="↻" FontSize="14" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>

                                <!-- Recommendations List -->
                                <ItemsControl ItemsSource="{Binding AiProjectAllocations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                            <TextBlock Text="{Binding CandidateUser.FullName}" FontWeight="Bold" FontSize="11" Foreground="#0f172a" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding CandidateUser.Title}" FontSize="10" Foreground="#64748b" Margin="0,0,6,0"/>
                                                            <Border Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="5,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding TeamBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#334155"/>
                                                            </Border>
                                                            <Border Background="#eff6ff" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="8" Padding="5,1">
                                                                <TextBlock Text="{Binding WorkloadBadge}" FontSize="9" FontWeight="Bold" Foreground="#1d4ed8"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RecommendationReason}" FontSize="9.5" Foreground="#475569"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quarter Selection & Filter Bar -->
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Controls (Year, Team, Status, Budget Filter) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- Year Filter -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Yıl:" FontWeight="Bold" Foreground="#4a5568" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="65" Height="26" FontSize="11"/>
                            </StackPanel>

                            <!-- Team Filter -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Ekip:" FontWeight="Bold" Foreground="#1e40af" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding TeamFilterList}" SelectedItem="{Binding SelectedTeamFilter}" Width="100" Height="26" FontSize="11"/>
                            </StackPanel>

                            <!-- Status Filter -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Durum:" FontWeight="Bold" Foreground="#0284c7" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding StatusFilterList}" SelectedItem="{Binding SelectedStatusFilter}" Width="105" Height="26" FontSize="11"/>
                            </StackPanel>

                            <!-- Budget Filter -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Bütçe:" FontWeight="Bold" Foreground="#16a34a" VerticalAlignment="Center" Margin="0,0,3,0" FontSize="11"/>
                                <ComboBox ItemsSource="{Binding BudgetFilterList}" SelectedItem="{Binding SelectedBudgetFilter}" Width="135" Height="26" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Quarter Tabs (Q1, Q2, Q3, Q4) -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding QuarterTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="QuarterGroup" 
                                                 Style="{StaticResource QuarterButtonStyle}"
                                                 Command="{Binding DataContext.SelectQuarterCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectsView}}}"
                                                 CommandParameter="{Binding Quarter}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EqualityToBoolConverter}" Mode="OneWay">
                                                <Binding Path="Quarter"/>
                                                <Binding Path="DataContext.SelectedQuarter" RelativeSource="{RelativeSource AncestorType={x:Type local:ProjectsView}}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding SubTitle, StringFormat=' ({0})'}" FontSize="10" Opacity="0.85"/>
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ProjectsList.Count, StringFormat='Toplam: {0} Kayıt'}" FontWeight="Bold" Foreground="#475569" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN WORKSPACE: 2-COLUMN GRID (Table Left, Side Detail Panel Right) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: FULL EXCEL-STYLE COMPACT DATAGRID TABLE -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="8">
                        <DataGrid ItemsSource="{Binding ProjectsList}" SelectedItem="{Binding SelectedProjectDisplay}" 
                                  AutoGenerateColumns="False" HeadersVisibility="Column" 
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True" CanUserSortColumns="True"
                                  CanUserResizeColumns="False" RowHeight="32" FontSize="10.5" GridLinesVisibility="Horizontal"
                                  PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding AuditTooltipText}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#0f172a"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#f8fafc"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#f0f9ff"/>
                                            <Setter Property="Foreground" Value="#0f172a"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Background" Value="#fffbeb"/>
                                            <Setter Property="BorderBrush" Value="#f59e0b"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="2,0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#0f172a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <!-- Sol İşlem & Detay Butonları (EN BAŞTA) -->
                                <DataGridTemplateColumn Header="İşlem / Detay" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Düzenle (Kilitli hal) -->
                                                <Button Content="✏️" Command="{Binding Data.ToggleRowEditCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding ReadVisibility}" Style="{StaticResource SecondaryButton}" 
                                                        Padding="4,2" FontSize="10" Margin="0,0,3,0" ToolTip="Bu satırın kutucuklarını düzenlemeye aç"/>
                                                
                                                <!-- Detay Formunu Aç (En Başta) -->
                                                <Button Content="ℹ️" Command="{Binding Data.OpenDetailPanelCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding ReadVisibility}" Style="{StaticResource SecondaryButton}" 
                                                        Padding="4,2" FontSize="10" ToolTip="Tüm detayların bulunduğu kayıt formunu sağda aç"/>
                                                
                                                <!-- Kaydet / İptal (Kilit Açık hal) -->
                                                <Button Content="💾" Command="{Binding Data.SaveRowEditCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding EditVisibility}" Background="#16a34a" Foreground="White" FontWeight="Bold" 
                                                        Padding="4,2" FontSize="10" Margin="0,0,3,0" ToolTip="Değişiklikleri kaydet ve kilitle"/>
                                                
                                                <Button Content="✕" Command="{Binding Data.CancelRowEditCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding EditVisibility}" Style="{StaticResource SecondaryButton}" 
                                                        Padding="4,2" FontSize="10" ToolTip="İptal et"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Pergel No -->
                                <DataGridTemplateColumn Header="Pergel No" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Project.PergelNo}" FontWeight="Bold" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding Project.PergelNo, UpdateSourceTrigger=PropertyChanged}" Background="White" Foreground="#0f172a" FontSize="10" Padding="2,1" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Talep Özeti / Adı (Kısa Kutucuk: 110px) -->
                                <DataGridTemplateColumn Header="Talep Özeti / Proje Adı" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Project.ProjectName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.ProjectName}" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding Project.ProjectName, UpdateSourceTrigger=PropertyChanged}" Background="White" Foreground="#0f172a" FontSize="10" Padding="2,1" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Proje Türü -->
                                <DataGridTemplateColumn Header="Proje Türü" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding ReadVisibility}">
                                                    <Border CornerRadius="6" Padding="3,1" Background="#f1f5f9" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Project.ProjectType}" FontSize="9.5" FontWeight="Bold" Foreground="#334155"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Project.ExternalCompanyName, StringFormat=' ({0})'}" FontSize="9.5" Foreground="#c05621" FontWeight="Bold" Visibility="{Binding Project.ExternalCompanyName, Converter={StaticResource BoolToVisConverter}}"/>
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Data.ProjectTypeOptions, Source={StaticResource DataContextProxy}}" SelectedItem="{Binding Project.ProjectType}" Background="White" Foreground="#0f172a" FontSize="9.5" Padding="2,1" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Durum -->
                                <DataGridTemplateColumn Header="Durum" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Border CornerRadius="8" Padding="5,1" HorizontalAlignment="Center" Visibility="{Binding ReadVisibility}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#eff6ff"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Planlandı">
                                                                    <Setter Property="Background" Value="#fef3c7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Devam Ediyor">
                                                                    <Setter Property="Background" Value="#eff6ff"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Tamamlandı">
                                                                    <Setter Property="Background" Value="#dcfce7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="İptal">
                                                                    <Setter Property="Background" Value="#fee2e2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Project.ProjectStatus}" FontSize="9.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1e40af"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Planlandı">
                                                                        <Setter Property="Foreground" Value="#92400e"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Devam Ediyor">
                                                                        <Setter Property="Foreground" Value="#1e40af"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="Tamamlandı">
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Project.ProjectStatus}" Value="İptal">
                                                                        <Setter Property="Foreground" Value="#991b1b"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <ComboBox ItemsSource="{Binding Data.StatusOptions, Source={StaticResource DataContextProxy}}" SelectedItem="{Binding Project.ProjectStatus}" Background="White" Foreground="#0f172a" FontSize="9.5" Padding="2,1" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Analistler (Soyisim İlk Harf Kısaltmalı) -->
                                <DataGridTemplateColumn Header="Analistler" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedAnalystNames}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1e40af" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Yazılımcılar (Soyisim İlk Harf Kısaltmalı) -->
                                <DataGridTemplateColumn Header="Yazılımcılar" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedDeveloperNames}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#065f46" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Çeyreğin 3 Ayı (Düzenlenebilir Kutucuklar) -->
                                <DataGridTemplateColumn Header="{Binding Data.Month1Header, Source={StaticResource DataContextProxy}}" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Month1ManDaysTotal, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding Month1ManDaysTotal, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Background="White" Foreground="#0f172a" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{Binding Data.Month2Header, Source={StaticResource DataContextProxy}}" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Month2ManDaysTotal, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding Month2ManDaysTotal, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Background="White" Foreground="#0f172a" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{Binding Data.Month3Header, Source={StaticResource DataContextProxy}}" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Month3ManDaysTotal, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding Month3ManDaysTotal, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Background="White" Foreground="#0f172a" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Analist Maliyet (Düzenlenebilir) -->
                                <DataGridTemplateColumn Header="Analist Maliyet" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AnalystPlannedManDays, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" Foreground="#1e40af" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding AnalystPlannedManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Background="White" Foreground="#1e40af" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Yazılım Maliyet (Düzenlenebilir) -->
                                <DataGridTemplateColumn Header="Yazılım Maliyet" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeveloperPlannedManDays, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" Foreground="#065f46" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding DeveloperPlannedManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Background="White" Foreground="#065f46" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Toplam Maliyet (Otomatik Canlı Hesaplanan) -->
                                <DataGridTemplateColumn Header="Toplam Maliyet" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalInternalManDays, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0f172a"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Analist Efor (Düzenlenebilir) -->
                                <DataGridTemplateColumn Header="Analist Efor" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AnalystActualManDays, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" Foreground="#2563eb" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding AnalystActualManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Background="White" Foreground="#2563eb" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Yazılım Efor (Düzenlenebilir) -->
                                <DataGridTemplateColumn Header="Yazılım Efor" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeveloperActualManDays, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" Foreground="#059669" Visibility="{Binding ReadVisibility}"/>
                                                <TextBox Text="{Binding DeveloperActualManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Background="White" Foreground="#059669" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Toplam Efor (Otomatik Canlı Hesaplanan) -->
                                <DataGridTemplateColumn Header="Toplam Efor" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ActualManDays, StringFormat=\{0:N0\}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0f172a"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Bütçe Durum Rozeti -->
                                <DataGridTemplateColumn Header="Bütçe Durumu" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding BudgetStatusBg}"/>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding BudgetStatusBadge}" FontSize="9" FontWeight="Bold" Foreground="{Binding BudgetStatusColor}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- GMY (SAĞ TARAFA TAŞINDI) -->
                                <DataGridTemplateColumn Header="GMY" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Project.Gmy}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.Gmy}" Visibility="{Binding ReadVisibility}"/>
                                                <ComboBox ItemsSource="{Binding Data.GmyOptions, Source={StaticResource DataContextProxy}}" SelectedItem="{Binding Project.Gmy}" Background="White" Foreground="#0f172a" FontSize="9.5" Padding="2,1" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- İş Birimi (SAĞ TARAFA TAŞINDI) -->
                                <DataGridTemplateColumn Header="İş Birimi" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Project.BusinessUnit}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.BusinessUnit}" Visibility="{Binding ReadVisibility}"/>
                                                <ComboBox ItemsSource="{Binding Data.BusinessUnitOptions, Source={StaticResource DataContextProxy}}" SelectedItem="{Binding Project.BusinessUnit}" Background="White" Foreground="#0f172a" FontSize="9.5" Padding="2,1" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Dış Maliyet (Düzenlenebilir) -->
                                <DataGridTemplateColumn Header="Dış Maliyet" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" FontSize="10" Visibility="{Binding ReadVisibility}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Project.ExternalCost, StringFormat='\{0:N0\}'}"/>
                                                            <Setter Property="Foreground" Value="#c05621"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Project.ExternalCost}" Value="0">
                                                                    <Setter Property="Text" Value="-"/>
                                                                    <Setter Property="Foreground" Value="#a0aec0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding Project.ExternalCost, UpdateSourceTrigger=PropertyChanged, StringFormat='\{0:N0\}'}" Background="White" Foreground="#c05621" HorizontalContentAlignment="Center" FontSize="10" Padding="1,0" Visibility="{Binding EditVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Paydaşlar -->
                                <DataGridTextColumn Header="Paydaşlar" Binding="{Binding Project.Stakeholders}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- RIGHT COLUMN: SIDE DETAIL & INLINE EDITING PANEL -->
                    <Border Grid.Column="1" Visibility="{Binding DetailPanelVisibility}" 
                            Background="White" BorderBrush="{StaticResource ZiraatRed}" BorderThickness="1.5" 
                            CornerRadius="8" Width="480" Padding="14" Margin="10,0,0,0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Panel Header & Action Control Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailPanelTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ZiraatRed}"/>
                                    <TextBlock Text="{Binding PergelNo, StringFormat=' #{0}'}" FontSize="13" FontWeight="Bold" Foreground="#64748b" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- READ MODE BUTTONS -->
                                    <Button Content="✏️ Düzenle" Command="{Binding EditProjectCommand}" 
                                            Visibility="{Binding ReadModeVisibility}" 
                                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>

                                    <!-- EDIT MODE BUTTONS -->
                                    <Button Content="💾 Kaydet" Command="{Binding SaveInlineCommand}" 
                                            Visibility="{Binding EditModeVisibility}" 
                                            Background="#16a34a" Foreground="White" FontWeight="Bold" Padding="10,4" FontSize="11" Margin="0,0,6,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Content="✕ İptal" Command="{Binding CancelEditCommand}" 
                                            Visibility="{Binding EditModeVisibility}" 
                                            Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>

                                    <!-- CLOSE PANEL BUTTON -->
                                    <Button Command="{Binding CloseFormCommand}" Width="26" Height="26" Cursor="Hand" ToolTip="Paneli Kapat" Visibility="{Binding ReadModeVisibility}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="#fee2e2" CornerRadius="13">
                                                    <TextBlock x:Name="txt" Text="✕" Foreground="#dc2626" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#dc2626"/>
                                                        <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Panel Scrollable Content Body -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True" Padding="0,0,4,0">
                                <StackPanel>
                                    <!-- ========================================== -->
                                    <!-- VIEW 1: READ MODE (Net Bilgi Kartı)       -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding ReadModeVisibility}">
                                        <!-- Proje Adı Kartı -->
                                        <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="📌 TALEP ÖZETİ / PROJE ADI" FontSize="9.5" FontWeight="Bold" Foreground="#64748b"/>
                                                <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Künye Bilgileri Grid -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="🏷️ Proje Türü" FontSize="10" FontWeight="SemiBold" Foreground="#64748b"/>
                                                <TextBlock Text="{Binding ProjectType}" FontSize="11" FontWeight="Bold" Foreground="#1e293b"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="🚦 Durum" FontSize="10" FontWeight="SemiBold" Foreground="#64748b"/>
                                                <TextBlock Text="{Binding ProjectStatus}" FontSize="11" FontWeight="Bold" Foreground="#1e40af"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="🏛️ GMY" FontSize="10" FontWeight="SemiBold" Foreground="#64748b"/>
                                                <TextBlock Text="{Binding Gmy, TargetNullValue='-'}" FontSize="10.5" FontWeight="Bold" Foreground="#0f172a" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="🏢 İş Birimi" FontSize="10" FontWeight="SemiBold" Foreground="#64748b"/>
                                                <TextBlock Text="{Binding BusinessUnit, TargetNullValue='-'}" FontSize="10.5" FontWeight="Bold" Foreground="#0f172a" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Görevliler Panel -->
                                        <Border Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="👥 GÖREVLİ KADRO" FontSize="10" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="Analistler:" FontSize="10.5" Foreground="#1e40af" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding DisplayAnalystSummary}" FontSize="10.5" Foreground="#0f172a" TextWrapping="Wrap" Margin="70,0,0,0"/>
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="Yazılımcılar:" FontSize="10.5" Foreground="#065f46" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding DisplayDeveloperSummary}" FontSize="10.5" Foreground="#0f172a" TextWrapping="Wrap" Margin="70,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Personel & Aylık Efor Matrisi -->
                                        <Border BorderBrush="#bfdbfe" BorderThickness="1" Background="#eff6ff" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="📋 Personel Bazlı Ay ve Efor Dağılımı" FontWeight="Bold" FontSize="10.5" Foreground="#1e40af" Margin="0,0,0,6"/>
                                                
                                                <DataGrid ItemsSource="{Binding PersonMonthlyCostRows}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="60" MaxHeight="180" CanUserAddRows="False"
                                                          FontSize="10" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Personel" Binding="{Binding User.FullName}" Width="1.2*" IsReadOnly="True" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="{Binding Data.Month1Header, Source={StaticResource DataContextProxy}}" Binding="{Binding Month1ManDays, StringFormat=\{0:N0\}}" Width="45" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="{Binding Data.Month2Header, Source={StaticResource DataContextProxy}}" Binding="{Binding Month2ManDays, StringFormat=\{0:N0\}}" Width="45" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="{Binding Data.Month3Header, Source={StaticResource DataContextProxy}}" Binding="{Binding Month3ManDays, StringFormat=\{0:N0\}}" Width="45" IsReadOnly="True"/>
                                                        <DataGridTextColumn Header="Planlanan" Binding="{Binding TotalManDays, StringFormat=\{0:N0\}}" Width="55" IsReadOnly="True" FontWeight="Bold"/>
                                                        <DataGridTextColumn Header="Gerçekleşen" Binding="{Binding ActualManDays, StringFormat=\{0:N0\}}" Width="60" IsReadOnly="True" FontWeight="Bold"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bütçe & Maliyet Özeti Kartı -->
                                        <Border Background="#faf5ff" BorderBrush="#d8b4fe" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="📊 BÜTÇE &amp; EFOR MALİYET ÖZETİ" FontSize="10.5" FontWeight="Bold" Foreground="#6b21a8" Margin="0,0,0,6"/>
                                                
                                                <!-- Planlanan Breakdown -->
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="🎯 Planlanan Analist Eforu:" FontSize="10" Foreground="#1e40af"/>
                                                    <TextBlock Text="{Binding SelectedProjectDisplay.AnalystPlannedManDays, StringFormat='\{0:N0\} Adam/Gün'}" FontWeight="Bold" FontSize="10" Foreground="#1e40af" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="🎯 Planlanan Yazılımcı Eforu:" FontSize="10" Foreground="#065f46"/>
                                                    <TextBlock Text="{Binding SelectedProjectDisplay.DeveloperPlannedManDays, StringFormat='\{0:N0\} Adam/Gün'}" FontWeight="Bold" FontSize="10" Foreground="#065f46" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="🎯 Toplam Planlanan Bütçe:" FontSize="10" Foreground="#475569" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding TotalManDayBudget, StringFormat='\{0:N0\} Adam/Gün'}" FontWeight="ExtraBold" FontSize="10.5" Foreground="#0f172a" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Separator Background="#e9d5ff" Margin="0,2,0,4"/>

                                                <!-- Gerçekleşen Breakdown -->
                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="⏱️ Gerçekleşen Analist Eforu:" FontSize="10" Foreground="#2563eb"/>
                                                    <TextBlock Text="{Binding SelectedProjectDisplay.AnalystActualManDays, StringFormat='\{0:N0\} Adam/Gün'}" FontWeight="Bold" FontSize="10" Foreground="#2563eb" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="⏱️ Gerçekleşen Yazılımcı Eforu:" FontSize="10" Foreground="#059669"/>
                                                    <TextBlock Text="{Binding SelectedProjectDisplay.DeveloperActualManDays, StringFormat='\{0:N0\} Adam/Gün'}" FontWeight="Bold" FontSize="10" Foreground="#059669" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,3">
                                                    <TextBlock Text="⏱️ Toplam Gerçekleşen Efor:" FontSize="10" Foreground="#1d4ed8" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding ActualManDays, StringFormat='\{0:N0\} Adam/Gün'}" FontWeight="ExtraBold" FontSize="10.5" Foreground="#1d4ed8" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid Margin="0,2,0,0">
                                                    <TextBlock Text="💰 Dış Maliyet:" FontSize="10" Foreground="#475569"/>
                                                    <TextBlock Text="{Binding ExternalCost, StringFormat='\{0:N0\} TL'}" FontWeight="Bold" FontSize="10.5" Foreground="#c05621" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Paydaşlar -->
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="🏢 Paydaş Departmanlar:" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Text="{Binding Project.Stakeholders, TargetNullValue='-'}" FontSize="10.5" Foreground="#0f172a" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Açıklama / Notlar -->
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="📝 Açıklama / Notlar:" FontSize="10" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock Text="{Binding Description, TargetNullValue='-'}" FontSize="10.5" Foreground="#334155" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ========================================== -->
                                    <!-- VIEW 2: EDIT MODE (Canlı Düzenleme Formu) -->
                                    <!-- ========================================== -->
                                    <StackPanel Visibility="{Binding EditModeVisibility}">
                                        <!-- Pergel No & Ekip & Durum -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Pergel No" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                                <TextBox Text="{Binding PergelNo, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                                <TextBlock Text="Ekip" FontWeight="Bold" Foreground="#1e40af" Margin="0,0,0,2" FontSize="10.5"/>
                                                <ComboBox ItemsSource="{Binding TeamList}" SelectedItem="{Binding SelectedTeam}" Height="28" FontSize="11"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="Durum" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                                <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding ProjectStatus}" Height="28" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Talep Özeti / Adı -->
                                        <TextBlock Text="Talep Özeti / Proje Adı" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                        <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" Margin="0,0,0,10"/>

                                        <!-- Proje Türü & Dış Firma -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Proje Türü" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                                <ComboBox ItemsSource="{Binding TypeList}" SelectedItem="{Binding ProjectType}" Height="28" FontSize="11"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Visibility="{Binding IsExternalCompanyVisible}" Margin="5,0,0,0">
                                                <TextBlock Text="Dış Firma Adı" FontWeight="Bold" Foreground="#c05621" Margin="0,0,0,2" FontSize="10.5"/>
                                                <TextBox Text="{Binding ExternalCompanyName, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11" BorderBrush="#fbd38d" Background="#fffaf0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- GMY & İş Birimi Seçimi -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="🏛️ GMY" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                                <ComboBox ItemsSource="{Binding GmyList}" Text="{Binding Gmy, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="28" FontSize="11"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="🏢 İş Birimi" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                                <ComboBox ItemsSource="{Binding BusinessUnitList}" Text="{Binding BusinessUnit, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Height="28" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Analistler & Yazılımcılar Seçim Kartı -->
                                        <Border BorderBrush="#cbd5e1" BorderThickness="1" Background="#f8fafc" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Analistler -->
                                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                    <TextBlock Text="Analistler:" FontWeight="Bold" FontSize="11" Foreground="#1e40af" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding AnalystUserItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding User.FullName}" Margin="0,2" FontSize="10.5"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Yazılımcılar -->
                                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                    <TextBlock Text="Yazılımcılar:" FontWeight="Bold" FontSize="11" Foreground="#065f46" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding DeveloperUserItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding User.FullName}" Margin="0,2" FontSize="10.5"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Düzenlenebilir Efor Dağılım Tablosu -->
                                        <Border BorderBrush="#bfdbfe" BorderThickness="1.5" Background="#eff6ff" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🗓️ ÇEYREK AYLIK ADAM-GÜN MALİYETİ" FontWeight="Bold" FontSize="10.5" Foreground="#1e40af" Margin="0,0,0,6"/>

                                                <DataGrid ItemsSource="{Binding PersonMonthlyCostRows}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="80" MaxHeight="180" CanUserAddRows="False"
                                                          FontSize="10" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Personel" Binding="{Binding User.FullName}" Width="1.1*" IsReadOnly="True" FontWeight="Bold"/>
                                                        
                                                        <DataGridTemplateColumn Header="{Binding Data.Month1Header, Source={StaticResource DataContextProxy}}" Width="55">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Month1ManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" Height="22" Width="45" TextAlignment="Center" FontWeight="Bold" BorderBrush="#cbd5e1"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTemplateColumn Header="{Binding Data.Month2Header, Source={StaticResource DataContextProxy}}" Width="55">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Month2ManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" Height="22" Width="45" TextAlignment="Center" FontWeight="Bold" BorderBrush="#cbd5e1"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTemplateColumn Header="{Binding Data.Month3Header, Source={StaticResource DataContextProxy}}" Width="55">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding Month3ManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" Height="22" Width="45" TextAlignment="Center" FontWeight="Bold" BorderBrush="#cbd5e1"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTemplateColumn Header="Gerçekleşen" Width="65">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBox Text="{Binding ActualManDays, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" Height="22" Width="50" TextAlignment="Center" FontWeight="Bold" Foreground="#1d4ed8" BorderBrush="#93c5fd"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bütçe & Dış Maliyet Input -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Proje Bütçesi (Gün)" FontWeight="Bold" Foreground="#1e40af" Margin="0,0,0,2" FontSize="10.5"/>
                                                <TextBox Text="{Binding TotalManDayBudget, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:0.##\}}" Height="28" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Dış Maliyet (TL)" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                                <TextBox Text="{Binding ExternalCost, UpdateSourceTrigger=PropertyChanged}" Height="28" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Paydaşlar Seçimi -->
                                        <TextBlock Text="🏢 Paydaş Departmanlar" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,4" FontSize="10.5"/>
                                        <ItemsControl ItemsSource="{Binding StakeholderItems}" Margin="0,0,0,10">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}" Margin="0,0,8,4" FontSize="10.5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Açıklama -->
                                        <TextBlock Text="📝 Açıklama / Notlar" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,2" FontSize="10.5"/>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,0,0,12"/>

                                        <!-- Save / Delete Actions inside Edit Mode -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="{Binding SaveButtonText}" Command="{Binding SaveInlineCommand}" Background="#16a34a" Foreground="White" FontWeight="Bold" Height="34" Margin="0,0,6,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="5" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Grid.Column="1" Content="🗑️ Sil" Command="{Binding DeleteProjectCommand}" Background="#e53e3e" Foreground="White" FontWeight="Bold" Width="70" Height="34">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="5" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
