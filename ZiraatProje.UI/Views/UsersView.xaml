<UserControl x:Class="ZiraatProje.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZiraatProje.UI.Views"
             xmlns:helpers="clr-namespace:ZiraatProje.UI.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid Background="Transparent" Margin="25">
        
        <!-- ========================================================================= -->
        <!-- SECTION 1: ADMIN MANAGEMENT VIEW (Only visible to Administrators)          -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding AdminPanelVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Admin Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Ekip Üyeleri ve Ekip Yönetimi" FontSize="22" FontWeight="Bold" Foreground="#1a202c"/>
                <TextBlock Text="Sistemdeki ekip üyelerini, unvanlarını, yetkilerini ve ekipleri kolayca yönetin" FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Master-Detail Content Layout -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{Binding FormColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Users List Grid (Takes 100% width when forms closed) -->
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Action Buttons Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="📋 Kayıtlı Ekip Üyeleri Listesi" FontSize="16" FontWeight="Bold" Foreground="#2d3748" VerticalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- Button 1: Add New Team Member -->
                                <Button Command="{Binding OpenUserFormCommand}" Style="{StaticResource NormalLoginButton}" Width="Auto" Padding="14,6" Height="32" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕ " FontSize="12"/>
                                        <TextBlock Text="Yeni Ekip Üyesi Ekle" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Button 2: Manage Teams -->
                                <Button Command="{Binding OpenTeamFormCommand}" Style="{StaticResource SecondaryButton}" Width="Auto" Padding="14,6" Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁 " FontSize="12"/>
                                        <TextBlock Text="Ekip Tanımla / Yönet" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding UsersViewCollection}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" HeadersVisibility="Column" ScrollViewer.CanContentScroll="False" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,2" Padding="12,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#f8fafc"/>
                                                        <Setter Property="BorderBrush" Value="#cbd5e0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="Takip">
                                                                <Setter Property="Background" Value="#f5f3ff"/>
                                                                <Setter Property="BorderBrush" Value="#ddd6fe"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Tahsis">
                                                                <Setter Property="Background" Value="#ecfdf5"/>
                                                                <Setter Property="BorderBrush" Value="#a7f3d0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Teminat">
                                                                <Setter Property="Background" Value="#eff6ff"/>
                                                                <Setter Property="BorderBrush" Value="#bfdbfe"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="Departman Yönetimi">
                                                                <Setter Property="Background" Value="#fff5f5"/>
                                                                <Setter Property="BorderBrush" Value="#fca5a5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="🏢"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Takip">
                                                                        <Setter Property="Text" Value="🟣"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Tahsis">
                                                                        <Setter Property="Text" Value="🟢"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Teminat">
                                                                        <Setter Property="Text" Value="🔵"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Departman Yönetimi">
                                                                        <Setter Property="Text" Value="👑"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Name, StringFormat='\{0\} Ekibi'}"/>
                                                                <Setter Property="Foreground" Value="#2d3748"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Takip">
                                                                        <Setter Property="Foreground" Value="#5b21b6"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Tahsis">
                                                                        <Setter Property="Foreground" Value="#065f46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Teminat">
                                                                        <Setter Property="Foreground" Value="#1e40af"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Departman Yönetimi">
                                                                        <Setter Property="Text" Value="Departman Yöneticisi"/>
                                                                        <Setter Property="Foreground" Value="#991b1b"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#718096"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Takip">
                                                                        <Setter Property="Background" Value="#7c3aed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Tahsis">
                                                                        <Setter Property="Background" Value="#059669"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Teminat">
                                                                        <Setter Property="Background" Value="#2563eb"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Departman Yönetimi">
                                                                        <Setter Property="Background" Value="#bc171d"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ItemCount, StringFormat='\{0\} Personel'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Personel" Binding="{Binding FullName}" Width="1.3*"/>
                                
                                <DataGridTextColumn Header="Unvan" Binding="{Binding Title}" Width="1*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Ekip" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#edf2f7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Team}" Value="Takip">
                                                                <Setter Property="Background" Value="#f5f3ff"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Team}" Value="Tahsis">
                                                                <Setter Property="Background" Value="#ecfdf5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Team}" Value="Teminat">
                                                                <Setter Property="Background" Value="#eff6ff"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Team}" Value="Departman Yönetimi">
                                                                <Setter Property="Background" Value="#ffeef0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="🏢"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Takip">
                                                                        <Setter Property="Text" Value="🟣"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Tahsis">
                                                                        <Setter Property="Text" Value="🟢"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Teminat">
                                                                        <Setter Property="Text" Value="🔵"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Departman Yönetimi">
                                                                        <Setter Property="Text" Value="👑"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DisplayTeamName}" FontWeight="Bold" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#4a5568"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Takip">
                                                                        <Setter Property="Foreground" Value="#6d28d9"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Tahsis">
                                                                        <Setter Property="Foreground" Value="#047857"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Teminat">
                                                                        <Setter Property="Foreground" Value="#1d4ed8"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Team}" Value="Departman Yönetimi">
                                                                        <Setter Property="Foreground" Value="#991b1b"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="E-Posta" Binding="{Binding Email}" Width="1.8*"/>
                                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="1.2*"/>
                                <DataGridCheckBoxColumn Header="Yönetici" Binding="{Binding IsAdmin}" Width="0.7*">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource ZiraatRed}" Margin="0,10,0,0" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <!-- Right Column: Collapsible / Sliding Form Panel (Appears when button is clicked or user selected) -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True" Margin="15,0,0,0">
                    <StackPanel>
                        
                        <!-- 1. EKİP ÜYESİ KAYIT / DÜZENLEME FORMU -->
                        <Border Visibility="{Binding UserFormVisibility}" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="👤 Ekip Üyesi Kayıt / Düzenleme" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ZiraatRed}" VerticalAlignment="Center"/>
                                    <Button Content="✕ Kapat" Command="{Binding CloseUserFormCommand}" 
                                            Background="Transparent" Foreground="#e53e3e" FontWeight="Bold" FontSize="11" 
                                            BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Ad -->
                                <TextBlock Text="Ad" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,12"/>

                                <!-- Soyad -->
                                <TextBlock Text="Soyad" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,12"/>

                                <!-- E-Posta -->
                                <TextBlock Text="E-Posta Adresi" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,12"/>

                                <!-- Telefon Numarası -->
                                <TextBlock Text="Telefon Numarası" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,5"/>
                                <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Height="34" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#f1f5f9" Padding="10,0" BorderBrush="#cbd5e1" BorderThickness="0,0,1,0" CornerRadius="5,0,0,5">
                                            <TextBlock Text="+90" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding UserPhone, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="10,6" BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center" MaxLength="15"/>
                                    </Grid>
                                </Border>

                                <!-- Unvan -->
                                <TextBlock Text="Unvan" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding Title}" SelectedValuePath="Content" Height="32" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Developer"/>
                                    <ComboBoxItem Content="Analist"/>
                                    <ComboBoxItem Content="DevOps Uzmanı"/>
                                    <ComboBoxItem Content="Test Uzmanı"/>
                                </ComboBox>

                                <!-- Ekip -->
                                <TextBlock Text="Ekip" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding TeamsList}" DisplayMemberPath="TeamName" SelectedValuePath="TeamName" SelectedValue="{Binding Team}" Height="32" Margin="0,0,0,12"/>

                                <!-- Yetki -->
                                <CheckBox IsChecked="{Binding IsAdmin}" Content="Yönetici Yetkisi Ver" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,5,0,10"/>

                                <!-- Otomatik Geçici Şifre Atama -->
                                <CheckBox IsChecked="{Binding AutoAssignPassword}" Content="Otomatik Geçici Şifre Ata (1234)" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,12"/>

                                <!-- Bilgilendirme Notu -->
                                <Border Background="#fff5f5" BorderBrush="#feb2b2" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,18">
                                    <TextBlock Text="🔑 Eklenen yeni ekip üyesine varsayılan olarak '1234' geçici şifresi atanacaktır." FontSize="11" Foreground="#c53030" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Action Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Kaydet" Command="{Binding SaveCommand}" Style="{StaticResource NormalLoginButton}" Height="36" Margin="0,0,5,0"/>
                                    <Button Grid.Column="1" Content="Sil" Command="{Binding DeleteCommand}" Background="#e53e3e" Foreground="White" FontWeight="Bold" Height="36" Margin="5,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="Border" CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#c53030"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Button Content="Temizle / Yeni Kayıt" Command="{Binding ClearFormCommand}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. EKİP TANIMLAMA & YÖNETİMİ FORMU -->
                        <Border Visibility="{Binding TeamFormVisibility}" Background="#fcf8f8" BorderBrush="{StaticResource ZiraatRed}" BorderThickness="1.5" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️ " FontSize="14"/>
                                        <TextBlock Text="Ekip Yönetimi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ZiraatRed}"/>
                                    </StackPanel>
                                    <Button Content="✕ Kapat" Command="{Binding CloseTeamFormCommand}" 
                                            Background="Transparent" Foreground="#e53e3e" FontWeight="Bold" FontSize="11" 
                                            BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Add Team Input Row -->
                                <TextBlock Text="Yeni Ekip Adı" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewTeamName, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+ Ekip Ekle" Command="{Binding AddTeamCommand}" Style="{StaticResource NormalLoginButton}" Width="100" Height="34" FontSize="12"/>
                                </Grid>

                                <!-- Existing Teams Chips -->
                                <TextBlock Text="Mevcut Ekipler:" FontSize="12" FontWeight="SemiBold" Foreground="#4a5568" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding TeamsList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#cbd5e0" BorderThickness="1" CornerRadius="16" Padding="10,5" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TeamName}" FontWeight="Bold" Foreground="#2d3748" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Button Content="✕" Command="{Binding DataContext.RemoveTeamCommand, RelativeSource={RelativeSource AncestorType={x:Type local:UsersView}}}" CommandParameter="{Binding}" Background="Transparent" Foreground="#e53e3e" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Padding="0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========================================================================= -->
        <!-- SECTION 2: REGULAR USER DIRECTORY VIEW (Read-Only Team & Contact Directory) -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding UserDirectoryVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Directory Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Ekip &amp; Personel Rehberi" FontSize="22" FontWeight="Bold" Foreground="#1a202c"/>
                <TextBlock Text="Departmanımızdaki 3 ekibi (Takip, Tahsis, Teminat) ve çalışan iletişim bilgilerini görüntüleyin." FontSize="13" Foreground="#718096" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Teams Grid / Directory Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" helpers:MouseWheelScrollHelper.EnableMouseWheelScroll="True">
                <StackPanel>
                    <!-- TOP CENTERED: Departman Yöneticisi Card -->
                    <ContentControl Content="{Binding ManagerGroup}" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ManagerGroup}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="18" Width="380" Background="#ffeef0" BorderBrush="#fca5a5" BorderThickness="1.5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Team Card Title -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="36" Height="36" CornerRadius="8" Background="#bc171d">
                                                <TextBlock Text="👑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Departman Yöneticisi" FontSize="16" FontWeight="Bold" Foreground="#991b1b"/>
                                                <TextBlock Text="{Binding Members.Count, StringFormat='\{0\} Personel'}" FontSize="11" Foreground="#718096"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,12"/>

                                        <!-- Team Members List -->
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Members}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectContactUserCommand, RelativeSource={RelativeSource AncestorType={x:Type local:UsersView}}}" CommandParameter="{Binding}" Height="Auto" MinHeight="52" Margin="0,0,0,4" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Name="MemberBorder" Background="White" BorderBrush="#cbd5e0" BorderThickness="1" CornerRadius="8" Padding="12,10" MinHeight="50">
                                                                    <Grid HorizontalAlignment="Stretch">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Grid.Column="0" Background="{StaticResource ZiraatRed}" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center">
                                                                            <TextBlock Text="👤" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>

                                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="13" Foreground="#2d3748" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="2" Text="🛈 İletişim" FontSize="11" Foreground="{StaticResource ZiraatRed}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="MemberBorder" Property="Background" Value="{StaticResource SoftPink}"/>
                                                                        <Setter TargetName="MemberBorder" Property="BorderBrush" Value="{StaticResource ZiraatRed}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!-- BOTTOM: 3 Teams Side by Side -->
                    <ItemsControl ItemsSource="{Binding TeamGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Margin="6,0,6,15" Padding="18" VerticalAlignment="Top" BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeamName}" Value="Takip">
                                                <Setter Property="Background" Value="#f5f3ff"/>
                                                <Setter Property="BorderBrush" Value="#ddd6fe"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TeamName}" Value="Tahsis">
                                                <Setter Property="Background" Value="#ecfdf5"/>
                                                <Setter Property="BorderBrush" Value="#a7f3d0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TeamName}" Value="Teminat">
                                                <Setter Property="Background" Value="#eff6ff"/>
                                                <Setter Property="BorderBrush" Value="#bfdbfe"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TeamName}" Value="Departman Yönetimi">
                                                <Setter Property="Background" Value="#ffeef0"/>
                                                <Setter Property="BorderBrush" Value="#fca5a5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Team Card Title -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="36" Height="36" CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#cbd5e0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TeamName}" Value="Takip">
                                                            <Setter Property="Background" Value="#7c3aed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TeamName}" Value="Tahsis">
                                                            <Setter Property="Background" Value="#059669"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TeamName}" Value="Teminat">
                                                            <Setter Property="Background" Value="#2563eb"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TeamName}" Value="Departman Yönetimi">
                                                            <Setter Property="Background" Value="#bc171d"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="🏢"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Takip">
                                                                <Setter Property="Text" Value="🟣"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Tahsis">
                                                                <Setter Property="Text" Value="🟢"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Teminat">
                                                                <Setter Property="Text" Value="🔵"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Departman Yönetimi">
                                                                <Setter Property="Text" Value="👑"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="16" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding TeamName, StringFormat='{} {0} Ekibi'}"/>
                                                        <Setter Property="Foreground" Value="#2d3748"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Takip">
                                                                <Setter Property="Foreground" Value="#5b21b6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Tahsis">
                                                                <Setter Property="Foreground" Value="#065f46"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Teminat">
                                                                <Setter Property="Foreground" Value="#1e40af"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TeamName}" Value="Departman Yönetimi">
                                                                <Setter Property="Text" Value="Departman Yöneticisi"/>
                                                                <Setter Property="Foreground" Value="#991b1b"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Members.Count, StringFormat='\{0\} Personel'}" FontSize="11" Foreground="#718096"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,12"/>

                                    <!-- Team Members List -->
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Members}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectContactUserCommand, RelativeSource={RelativeSource AncestorType={x:Type local:UsersView}}}" CommandParameter="{Binding}" Height="Auto" MinHeight="52" Margin="0,0,0,8" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Name="MemberBorder" Background="White" BorderBrush="#cbd5e0" BorderThickness="1" CornerRadius="8" Padding="12,10" MinHeight="50">
                                                                <Grid HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0" Background="{StaticResource ZiraatRed}" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center">
                                                                        <TextBlock Text="👤" Foreground="White" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="13" Foreground="#2d3748" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#718096" Margin="0,2,0,0"/>
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="2" Text="🛈 İletişim" FontSize="11" Foreground="{StaticResource ZiraatRed}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="MemberBorder" Property="Background" Value="{StaticResource SoftPink}"/>
                                                                    <Setter TargetName="MemberBorder" Property="BorderBrush" Value="{StaticResource ZiraatRed}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========================================================================= -->
        <!-- GLOBAL OVERLAY MODAL: PERSONEL İLETİŞİM DETAYLARI (Always On Top)          -->
        <!-- ========================================================================= -->
        <Grid Visibility="{Binding ContactCardVisibility}" Panel.ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Semi-transparent dark overlay background -->
            <Border Background="#80000000"/>

            <!-- Contact Detail Card -->
            <Border Width="440" Height="360" Background="White" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.35" ShadowDepth="5"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#bc171d" Width="42" Height="42" CornerRadius="21">
                                <TextBlock Text="👤" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedContactUser.FullName}" FontSize="18" FontWeight="Bold" Foreground="#1a202c"/>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0">
                                    <Run Text="{Binding SelectedContactUser.Title, Mode=OneWay}" Foreground="{StaticResource ZiraatRed}"/>
                                    <Run Text="{Binding SelectedContactUser.SubTitleDotTeam, Mode=OneWay}" Foreground="#718096"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseContactCardCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#a0aec0" FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <Border Grid.Row="0" Height="1" Background="#e2e8f0" VerticalAlignment="Bottom" Margin="0,15,0,0"/>

                    <!-- Details Body -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="10,10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💼 Unvan:" FontWeight="SemiBold" Foreground="#718096" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedContactUser.Title}" FontWeight="Bold" Foreground="#2d3748" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Visibility="{Binding SelectedContactUser.HasTeam, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏢 Ekip:" FontWeight="SemiBold" Foreground="#718096" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedContactUser.Team, StringFormat='\{0\} Ekibi'}" FontWeight="Bold" Foreground="#2d3748" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✉️ E-Posta:" FontWeight="SemiBold" Foreground="#718096" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedContactUser.Email}" FontWeight="Bold" Foreground="#2b6cb0" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📞 Telefon:" FontWeight="SemiBold" Foreground="#718096" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedContactUser.PhoneFormatted}" FontWeight="Bold" Foreground="#2d3748" FontSize="14" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- Footer Button -->
                    <Button Grid.Row="2" Content="Kapat" Command="{Binding CloseContactCardCommand}" Style="{StaticResource NormalLoginButton}" Height="38"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
